        WaitTextbox(8);
        SetAnim(30);
        SetAnimFrame(78);
        PlayAnimToFrame(119);
        WaitAnimEnd();
        OpenTextbox(9); // "Maeda. {Aya},,,! What's / wrong,,,?"
