        SetFogNearFar(160, 112, 1);
        SetFadeColor(4);
        WaitScreenFade();
        PlayFieldSfx(3, 0, 5);
        OpenTextbox(10); // "Daniel. Ha! You were great: / {Aya}!! Shows that only MY / partner can pull it off: eh?"
        PlayFieldSfx(2, 0, 4);
        SetAnim(31);
        SetAnimFrame(0);
        PlayAnimToFrame(59);
        WaitAnimEnd();
        WaitTextbox(10);
        while (room[20] == 0) {
            Wait(1);
        }
        room[20] = room[20] - 1;
        while (room[19] == 0) {
            Wait(1);
        }
        room[19] = room[19] - 1;
        PlayFieldSfx(3, 0, 6);
        OpenTextbox(11); // "Maeda. Yes, {Aya}: I'm relieved / that you made it back safely,"
        PlayFieldSfx(2, 0, 7);
        SetAnim(31);
        SetAnimFrame(59);
        PlayAnimToFrame(119);
        WaitAnimEnd();
        WaitTextbox(11);
        while (room[19] == 0) {
            Wait(1);
        }
        room[19] = room[19] - 1;
        while (room[20] == 0) {
            Wait(1);
        }
        room[20] = room[20] - 1;
        StartScreenFade(4);
        WaitScreenFade();
        LoadGeomState(2);
        SetFadeColor(4);
        WaitScreenFade();
        OpenTextbox(12); // "Daniel. Why the hell did Eve have to / bring all this to the Statue of / Liberty?"
        WaitTextbox(12);
        OpenTextbox(13); // "Maeda. Because of the ocean and what / it symbolizes,,, | The sea is the mother of all ..."
        WaitTextbox(13);
        global[AREA] = 726;
        StartScreenFade(30);
        WaitScreenFade();
        global[ROOM] = 425;
        ChangeRoom(0xA80472C8);
        ExitThread();
    @label_0298:
        ExitThread();
    @label_029C:
        GetThreadTarget14(local[4]);
        ExitThread();
    }

