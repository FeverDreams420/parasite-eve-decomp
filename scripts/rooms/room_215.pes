            WaitScreenFade();
            global[ROOM] = 216;
            ChangeRoom(0xA8041148);
        }
        ExitThread();
    @label_0198:
        MoveTowardPoint(-2158.0fp, 1167.0fp, 45);
        ExitThread();
    }

    actor_script actor_1 {
