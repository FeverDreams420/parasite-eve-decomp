    @label_00C4:
        GetThreadTarget14(local[4]);
        if (local[4] == 254) {
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
        }
        if (local[4] == 255) {
            ResumeSceneEvents();
            SetAnim(21);
