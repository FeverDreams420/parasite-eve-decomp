    actor_script actor_2 {
        Wait(1);
        local[6] = 0;
        while (1) {
            GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
            TestPointInQuad(1982.0fp, -724.0fp, 1982.0fp, -1409.0fp, 2182.0fp, -1409.0fp, 2182.0fp, -724.0fp, local[0], local[2], local[4]);
