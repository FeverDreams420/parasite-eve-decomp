// Parasite Eve 1 Scene Script (room_068)
room_script room_068 {
    spawn_table { (1, 0) }

    actor_script actor_0 {
        SetHitCylinder(100, 110, 20);
        SceneCmd(2601, 128, 0, 0, 0, 0, 0, local[0]);
        SetEventHandler(EVENT_INTERACT, @label_01CA);
        SetEventHandler(EVENT_TOUCH, @label_01C6);
        SetEntityVec3(VEC3_POS, 3066.0fp, 0.0fp, -6714.0fp);
        SetEntityVec3(VEC3_ROT, 0, 1024, 0);
        if (global[ROOM] == 72) {
            if (global[54] & 1) {
                SetEntityVec3(VEC3_POS, -114.0fp, 0.0fp, -7314.0fp);
                SetEntityVec3(VEC3_ROT, 0, 3072, 0);
                global[54] = global[54] & -2;
            } else {
                SetEntityVec3(VEC3_POS, 3066.0fp, 0.0fp, -6714.0fp);
                SetEntityVec3(VEC3_ROT, 0, 1024, 0);
            }
        }
        if (global[ROOM] == 71) {
            SetEntityVec3(VEC3_POS, 1150.0fp, 0.0fp, -7100.0fp);
            SetEntityVec3(VEC3_ROT, 0, 2048, 0);
        }
        SetAnim(21);
        UnlockPlayerInput();
        ResumeSceneEvents();
        ExitThread();
        ExitThread();
    @label_00FA:
        OpenTextbox(36); // "Eve. The holiday season brings joy / to us all,,,"
        SetAnim(22);
        MoveTowardPoint(1150.0fp, -7100.0fp, 50);
        SetAnim(21);
        StopActorMotion();
        CameraSnapToActor(2, 0, 100);
        WaitTextbox(36);
        PauseSceneEvents();
        StartScreenFade(30);
        WaitScreenFade();
        global[ROOM] = 72;
        ChangeRoom(0xA80070C8);
        ExitThread();
    @label_014A:
        StartScreenFade(30);
        WaitScreenFade();
        LoadGeomState(1);
        global[AREA] = 240;
        SetEntityVec3(VEC3_POS, 1150.0fp, 0.0fp, -7100.0fp);
        SetEntityVec3(VEC3_ROT, 0, 2048, 0);
        AkaoCmd(0xC8, 18, 0, 0, 0, room[17]);
        AkaoCmd(0xCD, 18, 0, 0, 0, room[17]);
        AkaoCmd(0xCF, 18, 30, 0, 127, room[17]);
        SetFadeColor(0x1E);
        WaitScreenFade();
        SetAnim(21);
        UnlockPlayerInput();
        ResumeSceneEvents();
        ExitThread();
    @label_01C6:
        ExitThread();
    @label_01CA:
        GetThreadTarget14(local[4]);
        if (local[4] == 1) {
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            AkaoCmd(0xCE, 9, 30, 0, 0, room[17]);
            if (global[STORY_FLAGS] & 4) {
                OpenTextbox(7); // "Will you watch this event? / <FB:09>2 Watch / Skip"
                WaitTextbox(7);
                GetChoiceResult(local[5]);
                if (local[5] == 0) {
                    goto @label_00FA;
                } else {
                    goto @label_014A;
                }
            } else {
                goto @label_00FA;
            }
            AkaoCmd(0xC8, 18, 0, 0, 0, room[17]);
            AkaoCmd(0xCD, 18, 0, 0, 0, room[17]);
            AkaoCmd(0xCF, 18, 30, 0, 127, room[17]);
            ExitThread();
        }
        if (local[4] == 2) {
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            Wait(30);
            OpenTextbox(108); // "{Aya}. I have to get backstage / and stop her,"
            WaitTextbox(108);
            SetAnim(21);
            UnlockPlayerInput();
            ResumeSceneEvents();
            ExitThread();
        }
        if (local[4] == 254) {
            KillOtherThreads();
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            ExitThread();
        }
        if (local[4] == 255) {
            KillOtherThreads();
            SetAnim(21);
            UnlockPlayerInput();
            ResumeSceneEvents();
            ExitThread();
        }
    }

    actor_script actor_1 {
        SetMeshFadeLevel(88);
        SetCameraBaseAngle(3904, 3950);
        AkaoCmd(0x193, 1016, 1016, 0, 0, room[17]);
        ClearScreenFadeFlag40();
        SpawnActor(0, 0, 0.0fp, 0.0fp, 0.0fp);
        SpawnActor(3, 0, 0.0fp, 0.0fp, 0.0fp);
        if (global[AREA] < 248) {
            SpawnActor(2, 0, 0.0fp, 0.0fp, 0.0fp);
        }
        if (global[AREA] >= 240) {
            LoadGeomState(1);
            if (global[AREA] < 248) {
                PlayFieldSfx(0, 0, 2);
            }
        }
        if (global[AREA] >= 248) {
            AkaoCmd(0xC8, 29, 0, 0, 0, room[17]);
        }
        if (global[AREA] < 248 && global[AREA] > 240) {
            AkaoCmd(0xC8, 18, 0, 0, 0, room[17]);
        }
        if (global[AREA] < 240) {
            AkaoCmd(0xC8, 9, 0, 0, 0, room[17]);
        }
        Wait(1);
        ResumeSceneEvents();
        SetFadeColor(0x1E);
    @label_012C:
        ExitThread();
        goto @label_012C;
        ExitThread();
    }

    actor_script actor_2 {
        SetHitCylinder(100, 130, 160);
        SceneCmd(2601, 128, 0, 0, 0, 0, 0, local[0]);
        SetEventHandler(EVENT_INTERACT, @label_0052);
        SetMoveSpeed(0xCCCC);
        EnableActorCollision();
        SetEntityVec3(VEC3_POS, 428.0fp, 0.0fp, -3014.0fp);
        SetEntityVec3(VEC3_ROT, 0, 0, 0);
        SetAnim(2);
        ExitThread();
    @label_0052:
        GetThreadTarget14(local[4]);
        if (local[4] == 1) {
            SetAnim(23);
            PlayAnimToFrame(800);
            WaitAnimEnd();
            SetAnim(2);
            ExitThread();
        }
        ExitThread();
    }

    actor_script actor_3 {
        Wait(1);
        SpawnThread(@label_001C);
        SpawnThread(@label_008A);
        SpawnThread(@label_0110);
        ExitThread();
    @label_001C:
        if (global[AREA] < 240) {
            GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
            TestPointInQuad(1311.0fp, -6864.0fp, 651.0fp, -6864.0fp, 1151.0fp, -8414.0fp, 1786.0fp, -8189.0fp, local[0], local[2], local[4]);
            if (local[4] == 1) {
                PlayFieldSfx(0, 0, 1);
                ExitThread();
            }
        }
        Wait(1);
        goto @label_001C;
    @label_008A:
        GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
        TestPointInQuad(3091.0fp, -7599.0fp, 3706.0fp, -7109.0fp, 3706.0fp, -7444.0fp, 3456.0fp, -7824.0fp, local[0], local[2], local[4]);
        if (local[4] == 1) {
            PauseSceneEvents();
            global[54] = global[54] | 1;
            LockPlayerInput();
            global[ROOM] = 69;
            StartScreenFade(30);
            Wait(30);
            ChangeRoom(0xA8007148);
            ExitThread();
        }
        Wait(1);
        goto @label_008A;
    @label_0110:
        GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
        TestPointInQuad(239.0fp, -8233.0fp, -651.0fp, -7853.0fp, -651.0fp, -8193.0fp, -391.0fp, -8343.0fp, local[0], local[2], local[4]);
        if (local[4] == 1) {
            PauseSceneEvents();
            global[54] = global[54] & -2;
            LockPlayerInput();
            global[ROOM] = 69;
            StartScreenFade(30);
            Wait(30);
            ChangeRoom(0xA8007148);
            ExitThread();
        }
        Wait(1);
        goto @label_0110;
    }
}
