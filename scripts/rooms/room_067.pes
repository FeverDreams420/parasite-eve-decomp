// Parasite Eve 1 Scene Script (room_067)
room_script room_067 {
    spawn_table { (1, 0) }

    actor_script actor_0 {
        SetHitCylinder(115, 125, 20);
        SceneCmd(2601, 128, 0, 0, 0, 0, 0, local[0]);
        SetEventHandler(EVENT_INTERACT, @label_00E4);
        SetEventHandler(EVENT_TOUCH, @label_00E0);
        SetEntityVec3(VEC3_POS, 1000.0fp, 0.0fp, 100.0fp);
        SetEntityVec3(VEC3_ROT, 0, 1378, 0);
        if (global[ROOM] == 67) {
            SetEntityVec3(VEC3_POS, 1000.0fp, 0.0fp, 100.0fp);
            SetEntityVec3(VEC3_ROT, 0, 1378, 0);
        }
        if (global[ROOM] == 72) {
            SetEntityVec3(VEC3_POS, -750.0fp, 0.0fp, 2799.0fp);
            SetEntityVec3(VEC3_ROT, 0, 3600, 0);
        }
        if (global[ROOM] == 73) {
            SetEntityVec3(VEC3_POS, -1429.0fp, 0.0fp, 111.0fp);
            SetEntityVec3(VEC3_ROT, 0, 2640, 0);
        }
        SetAnim(21);
        UnlockPlayerInput();
        ResumeSceneEvents();
        ExitThread();
        ExitThread();
    @label_00E0:
        ExitThread();
    @label_00E4:
        GetThreadTarget14(local[4]);
        if (local[4] == 1) {
            LockPlayerInput();
            StopActorMotion();
            SetAnim(22);
            MoveTowardPoint(-2019.0fp, 4931.0fp, 100);
            SetAnim(21);
        }
        if (local[4] == 254) {
            KillOtherThreads();
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            ExitThread();
        }
        if (local[4] == 255) {
            KillOtherThreads();
            SetAnim(21);
            UnlockPlayerInput();
            ResumeSceneEvents();
            ExitThread();
        }
        ExitThread();
    }

    actor_script actor_1 {
        if (global[AREA] >= 240) {
            AkaoCmd(0xC8, 29, 0, 0, 0, room[17]);
        } else {
            AkaoCmd(0xC8, 9, 0, 0, 0, room[17]);
        }
        AkaoCmd(0x193, 1016, 1016, 0, 0, room[17]);
        SetMeshFadeLevel(76);
        SetCameraBaseAngle(3600, 3566);
        ClearScreenFadeFlag40();
        SpawnActor(0, 0, 0.0fp, 0.0fp, 0.0fp);
        SpawnActor(2, 0, 0.0fp, 0.0fp, 0.0fp);
        SpawnActor(4, 0, 0.0fp, 0.0fp, 0.0fp);
        if (global[AREA] >= 248) {
            if (!(global[54] & 0x00040000)) {
                SpawnActor(3, 0, 0.0fp, 0.0fp, 0.0fp);
            }
        }
        if (global[AREA] < 248) {
            DisableCollisionTriangle(3);
        }
        Wait(1);
        ResumeSceneEvents();
        SetFadeColor(0x1E);
        UnlockPlayerInput();
        ExitThread();
        ExitThread();
    }

    actor_script actor_2 {
        Wait(1);
        SpawnThread(@label_001C);
        SpawnThread(@label_0114);
        SpawnThread(@label_0184);
        ExitThread();
    @label_001C:
        GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
        TestPointInQuad(-688.0fp, 3451.0fp, -688.0fp, 3518.0fp, -1544.0fp, 3518.0fp, -1544.0fp, 3451.0fp, local[0], local[2], local[4]);
        if (local[4] == 1) {
            PauseSceneEvents();
            LockPlayerInput();
            SetFogNearFar(160, 110, 90);
            Wait(90);
            if (global[AREA] < 248 && global[AREA] > 240) {
                AkaoCmd(0xCE, 29, 90, 0, 0, room[17]);
            }
            StartScreenFade(90);
            WaitScreenFade();
            if (global[AREA] < 248 && global[AREA] > 240) {
                AkaoCmd(0xC9, 29, 0, 0, 0, room[17]);
            }
            global[ROOM] = 68;
            ChangeRoom(0xA8007148);
            ExitThread();
        }
        Wait(1);
        goto @label_001C;
    @label_0114:
        GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
        TestPointInQuad(1000.0fp, -300.0fp, 1700.0fp, 650.0fp, 2400.0fp, -100.0fp, 1470.0fp, -779.0fp, local[0], local[2], local[4]);
        if (local[4] == 1) {
            PauseSceneEvents();
            LockPlayerInput();
            StartScreenFade(30);
            WaitScreenFade();
            global[ROOM] = 68;
            ChangeRoom(0xA80063C8);
            ExitThread();
        }
        Wait(1);
        goto @label_0114;
    @label_0184:
        GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
        TestPointInQuad(-2106.0fp, -88.0fp, -1022.0fp, -682.0fp, -1263.0fp, -961.0fp, -2951.0fp, -1030.0fp, local[0], local[2], local[4]);
        if (local[4] == 1) {
            PauseSceneEvents();
            LockPlayerInput();
            StartScreenFade(30);
            WaitScreenFade();
            global[ROOM] = 68;
            ChangeRoom(0xA8007248);
            ExitThread();
        }
        Wait(1);
        goto @label_0184;
    }

    actor_script actor_3 {
        SetEntityVec3(VEC3_POS, -1435.0fp, 0.0fp, -100.0fp);
        SetEntityVec3(VEC3_ROT, 0, 4080, 0);
        Wait(10);
        SetAnim(0);
        EnableActorCollision();
        SetMoveFactor(0x140000);
        SetAnim(2);
        MoveTowardPoint(-2438.0fp, -920.0fp, 100);
        global[54] = global[54] | 0x00040000;
        ExitThread();
    }

    actor_script actor_4 {
        SetEntityVec3(VEC3_POS, -1658.0fp, 0.0fp, -35.0fp);
        SetEntityVec3(VEC3_ROT, 0, 1824, 0);
        SetAnim(0);
        ExitThread();
        CheckPadInput(PAD_PRESSED, 0x20000000, local[5]);
        if (local[5] != 0) {
            OpenTextbox(94); // "{Aya}. Eve was here,,,"
            PlayFieldSfx(0, 0, 254);
            WaitTextbox(94);
            PlayFieldSfx(0, 0, 255);
        }
        ExitThread();
    }
}
