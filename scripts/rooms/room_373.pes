                            OpenTextbox(31); // "Warner. Harry rushed in there without / listening to Daniel and,,,"
                            SetAnim(3);
                            SetAnimFrame(0);
                            PlayAnimToFrame(80);
                            WaitTextbox(31);
                            DisableActorRendering();
                            SetAnim(0);
                            EnableActorRendering();
                            PlayFieldSfx(0, 0, 255);
                        }
                    }
                }
            }
        }
        ExitThread();
    }

    actor_script actor_5 {
        SetEventHandler(EVENT_TOUCH, @label_002A);
        SetEntityVec3(VEC3_POS, 289.0fp, 0.0fp, 1009.0fp);
        SetEntityVec3(VEC3_ROT, 0, 1184, 0);
        SetAnim(2);
        ExitThread();
    @label_002A:
        CheckPadInput(PAD_PRESSED, 0x20000000, local[5]);
        if (local[5] != 0) {
            OpenTextbox(110); // "{Aya}. He's dead,,,"
            PlayFieldSfx(0, 0, 254);
            WaitTextbox(110);
            PlayFieldSfx(0, 0, 255);
        }
        ExitThread();
    }
}
