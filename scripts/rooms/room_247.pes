// Parasite Eve 1 Scene Script (room_247)
room_script room_247 {
    spawn_table { (1, 0) }

    actor_script actor_0 {
        SetHitCylinder(85, 105, 10);
        SceneCmd(2601, 128, 0, 0, 0, 0, 0, local[0]);
        Wait(1);
        ScaleShadowRadius(0xB333);
        SetHitCylinderRadius(0x002C0000);
        SetEventHandler(EVENT_INTERACT, @label_0098);
        SetEventHandler(EVENT_TOUCH, @label_0094);
        if (global[ROOM] == 246) {
            SetEntityVec3(VEC3_POS, 946.0fp, 0.0fp, 972.0fp);
            SetEntityVec3(VEC3_ROT, 0, 2048, 0);
        } else {
            SetEntityVec3(VEC3_POS, 0.0fp, 0.0fp, 0.0fp);
            SetEntityVec3(VEC3_ROT, 0, 0, 0);
        }
        Wait(1);
        ExitThread();
    @label_0094:
        ExitThread();
    @label_0098:
        GetThreadTarget14(local[4]);
        if (local[4] == 254) {
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
        }
        if (local[4] == 255) {
            ResumeSceneEvents();
            SetAnim(21);
            UnlockPlayerInput();
        }
        if (local[4] == 251) {
            DestroySelf();
        }
        ExitThread();
    }

    actor_script actor_1 {
        ClearScreenFadeFlag40();
        PauseSceneEvents();
        LockPlayerInput();
        AkaoCmd(0x193, 1024, 1024, 0, 0, room[19]);
        SetCameraBaseAngle(0, 3808);
        SetMeshFadeLevel(112);
        if (global[AREA] < 632) {
            global[AREA] = 632;
        }
        AkaoCmd(0xCB, 27, 0, 1, 0, room[19]);
        AkaoCmd(0xCE, 27, 210, 5, 0, room[19]);
        SpawnActor(0, 0, 0.0fp, 0.0fp, 0.0fp);
        SpawnActor(2, 0, 0.0fp, 0.0fp, 0.0fp);
        Wait(1);
        SetEventHandler(EVENT_INTERACT, @label_00AC);
        Wait(1);
        SetFadeColor(0x1E);
        WaitScreenFade();
        ResumeSceneEvents();
        UnlockPlayerInput();
        ExitThread();
    @label_00AC:
        GetThreadTarget14(local[3]);
        ExitThread();
    }

    actor_script actor_2 {
        Wait(1);
        local[6] = 0;
        while (1) {
            GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
            TestPointInQuad(622.0fp, 872.0fp, 622.0fp, 672.0fp, 1270.0fp, 672.0fp, 1270.0fp, 872.0fp, local[0], local[2], local[4]);
            if (local[4] == 1 && local[6] == 0) {
                local[6] = 1;
                PlayFieldSfx(0, 0, 254);
                ResumeSceneEvents();
                UnlockPlayerInput();
                AkaoCmd(0xCE, 27, 30, 0, 0, room[19]);
                Wait(1);
                StartScreenFade(30);
                WaitScreenFade();
                global[ROOM] = 248;
                AkaoCmd(0xC9, 27, 0, 0, 0, room[19]);
                ChangeRoom(0xA8044348);
            }
            GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
            TestPointInQuad(-510.0fp, 1389.0fp, -510.0fp, 1548.0fp, -729.0fp, 1548.0fp, -729.0fp, 1389.0fp, local[0], local[2], local[4]);
            if (local[4] == 1 && local[6] == 0) {
                local[6] = 1;
                PlayFieldSfx(0, 0, 254);
                OpenTextbox(187); // "{Aya}. Eve's on the other side!"
                WaitTextbox(187);
                StartScreenFade(30);
                WaitScreenFade();
                global[ROOM] = 248;
                ChangeRoom(0xA80444C8);
            }
            Wait(1);
        }
        ExitThread();
    }
}
