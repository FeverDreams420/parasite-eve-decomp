    @label_0048:
        GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
        TestPointInQuad(-3490.0fp, -923.0fp, -3490.0fp, -8563.0fp, -6268.0fp, -8563.0fp, -6268.0fp, -923.0fp, local[0], local[2], local[4]);
        if (local[4] == 1) {
            PauseSceneEvents();
            LockPlayerInput();
            global[54] = global[54] | 1;
