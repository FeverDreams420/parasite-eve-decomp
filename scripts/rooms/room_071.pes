        }
        Wait(1);
        goto @label_0048;
    @label_00EE:
        GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
        TestPointInQuad(169.0fp, 911.0fp, 169.0fp, 1294.0fp, -902.0fp, 1294.0fp, -902.0fp, 911.0fp, local[0], local[2], local[4]);
        if (local[4] == 1) {
            PauseSceneEvents();
            LockPlayerInput();
            global[54] = global[54] & -2;
            StartScreenFade(30);
            Wait(30);
            global[ROOM] = 72;
            if (global[AREA] < 288) {
                ChangeRoom(0xA80064C8);
            } else {
                ChangeRoom(0xA80053C8);
            }
            ExitThread();
        }
        Wait(1);
        goto @label_00EE;
    @label_0194:
        GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
        TestPointInQuad(1000.0fp, 200.0fp, 500.0fp, 850.0fp, -200.0fp, 300.0fp, 400.0fp, -400.0fp, local[0], local[2], local[4]);
        if (local[4] == 1) {
            PlayFieldSfx(0, 0, 10);
            Wait(1);
            PlayFieldSfx(2, 0, 10);
            ExitThread();
        }
        Wait(1);
        goto @label_0194;
    @label_01FE:
        if (global[AREA] >= 240) {
            if (global[AREA] < 248) {
                GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
                TestPointInQuad(2978.0fp, 4251.0fp, 2978.0fp, 3247.0fp, 3276.0fp, 3247.0fp, 3276.0fp, 4251.0fp, local[0], local[2], local[4]);
                if (local[4] == 1) {
                    PauseSceneEvents();
                    LockPlayerInput();
                    StartScreenFade(30);
                    WaitScreenFade();
                    global[ROOM] = 72;
                    ChangeRoom(0xA8007048);
                    Wait(1);
                    ExitThread();
                }
            }
        }
        Wait(1);
        goto @label_01FE;
    @label_029C:
        GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
        TestPointInQuad(2500.0fp, -2665.0fp, 2500.0fp, -2974.0fp, 3568.0fp, -2974.0fp, 3568.0fp, -2665.0fp, local[0], local[2], local[4]);
        if (local[4] == 1) {
            PauseSceneEvents();
            LockPlayerInput();
            if (global[AREA] >= 240) {
