// Parasite Eve 1 Scene Script (room_071)
room_script room_071 {
    spawn_table { (1, 0) }

    actor_script actor_0 {
        SetHitCylinder(115, 130, 20);
        SceneCmd(2601, 128, 0, 0, 0, 0, 0, local[0]);
        SetEventHandler(EVENT_INTERACT, @label_011C);
        SetEventHandler(EVENT_TOUCH, @label_0118);
        if (global[ROOM] == 70) {
            SetEntityVec3(VEC3_POS, 2897.0fp, 0.0fp, 2423.0fp);
            SetEntityVec3(VEC3_ROT, 0, 76, 0);
        }
        if (global[ROOM] == 68) {
            SetEntityVec3(VEC3_POS, 2587.0fp, 0.0fp, -2392.0fp);
            SetEntityVec3(VEC3_ROT, 0, 1616, 0);
        }
        if (global[ROOM] == 69) {
            if (global[54] & 1) {
                SetEntityVec3(VEC3_POS, 533.0fp, 0.0fp, 89.0fp);
                SetEntityVec3(VEC3_ROT, 0, 0, 0);
                global[54] = global[54] & -2;
            } else {
                SetEntityVec3(VEC3_POS, -2456.0fp, 0.0fp, -1470.0fp);
                SetEntityVec3(VEC3_ROT, 0, 3072, 0);
            }
        }
        SetAnim(21);
        UnlockPlayerInput();
        ResumeSceneEvents();
        SetFadeColor(0x1E);
        WaitScreenFade();
        ExitThread();
        ExitThread();
    @label_0118:
        ExitThread();
    @label_011C:
        GetThreadTarget14(local[4]);
        if (local[4] == 1) {
            KillOtherThreads();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            SetMoveFactor(0x78000);
            SetAnim(23);
            MoveTowardPoint(2080.0fp, -1839.0fp, 100);
            SetAnim(21);
            StopActorMotion();
            SetMoveFactor(0x10000);
            OpenTextbox(40); // "{Aya}. Ben what happened?"
            SetAnim(31);
            SetAnimFrame(0);
            PlayAnimToFrame(80);
            WaitTextbox(40);
            ExitThread();
        }
        if (local[4] == 2) {
            SetAnim(31);
            SetAnimFrame(0);
            PlayAnimToFrame(200);
            WaitAnimEnd();
            SetAnim(21);
            ExitThread();
        }
        if (local[4] == 3) {
            OpenTextbox(42); // "{Aya}. Ben: we have to get out / of here: It's not safe,"
            SetAnim(31);
            SetAnimFrame(0);
            PlayAnimToFrame(800);
            WaitAnimEnd();
            WaitTextbox(42);
            UnlockPlayerInput();
            ExitThread();
        }
        if (local[4] == 4) {
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            ExitThread();
        }
        if (local[4] == 5) {
            OpenTextbox(44); // "{Aya}. I'll find your mom, Run: / go find your father,"
            SetAnim(32);
            SetAnimFrame(0);
            PlayAnimToFrame(200);
            WaitTextbox(44);
            SetAnim(21);
            UnlockPlayerInput();
            ExitThread();
        }
        if (local[4] == 10) {
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            Wait(60);
            SetAnim(21);
            UnlockPlayerInput();
            ResumeSceneEvents();
            ExitThread();
        }
        if (local[4] == 254) {
            KillOtherThreads();
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            ExitThread();
        }
        if (local[4] == 255) {
            KillOtherThreads();
            SetAnim(21);
            UnlockPlayerInput();
            ResumeSceneEvents();
            ExitThread();
        }
        ExitThread();
    }

    actor_script actor_1 {
        SetMeshFadeLevel(84);
        SetCameraBaseAngle(3664, 3664);
        AkaoCmd(0x193, 1016, 1016, 0, 0, room[17]);
        ClearScreenFadeFlag40();
        SpawnActor(0, 0, 0.0fp, 0.0fp, 0.0fp);
        SpawnActor(3, 0, 0.0fp, 0.0fp, 0.0fp);
        SetGeomEntryPos(3, 0, 0, -300);
        if (global[AREA] >= 240) {
            if (global[AREA] < 248) {
                if (!(global[54] & 256)) {
                    PlayFieldSfx(3, 0, 2);
                    SpawnActor(2, 0, 0.0fp, 0.0fp, 0.0fp);
                    ExitThread();
                }
            }
        }
        if (global[AREA] >= 248) {
            AkaoCmd(0xC8, 29, 0, 0, 0, room[17]);
        }
        if (global[AREA] < 248 && global[AREA] > 240) {
            AkaoCmd(0xC8, 18, 0, 0, 0, room[17]);
        }
        if (global[AREA] < 240) {
            AkaoCmd(0xC8, 9, 0, 0, 0, room[17]);
        }
        ResumeSceneEvents();
        Wait(1);
        ExitThread();
    }

    actor_script actor_2 {
        SetEntityVec3(VEC3_POS, 1216.0fp, 0.0fp, 1166.0fp);
        SetEntityVec3(VEC3_ROT, 0, 475, 0);
        SetEventHandler(EVENT_INTERACT, @label_0024);
        ExitThread();
    @label_0024:
        GetThreadTarget14(local[3]);
        if (local[3] == 10) {
            global[54] = global[54] | 256;
            global[AREA] = 244;
            SetAnim(8);
            SetAnimFrame(0);
            PlayAnimToFrame(70);
            WaitAnimEnd();
            SetAnim(2);
            SetMoveFactor(0x140000);
            MoveTowardPoint(1676.0fp, 1842.0fp, 180);
            SetAnimInterpRate(90);
            MoveTowardPoint(3176.0fp, 3371.0fp, 180);
            DestroySelf();
        }
        if (local[3] == 1) {
            OpenTextbox(74); // "Ben. ,,,I came here with mom: but,,, / she,,, she was all weird,"
            SetAnim(4);
            SetAnimFrame(0);
            PlayAnimToFrame(80);
            WaitAnimEnd();
            WaitTextbox(74);
            PlayFieldSfx(0, 0, 2);
            ExitThread();
        }
        if (local[3] == 2) {
            OpenTextbox(41); // "Ben. When I got close to the stage: / I felt,,,sick,,,I told mom I wanted / to go home,..."
            SetAnim(5);
            SetAnimFrame(0);
            PlayAnimToFrame(80);
            WaitAnimEnd();
            WaitTextbox(41);
            PlayFieldSfx(0, 0, 3);
            ExitThread();
        }
        if (local[3] == 3) {
            OpenTextbox(43); // "Ben. I'm not leaving without mom,"
            SetAnim(3);
            SetAnimFrame(0);
            PlayAnimToFrame(80);
            WaitAnimEnd();
            WaitTextbox(43);
            PlayFieldSfx(0, 0, 5);
            ExitThread();
        }
        if (local[3] == 4) {
            global[AREA] = 244;
            SetAnim(2);
            SetMoveFactor(0xF0000);
            MoveTowardPoint(10510.0fp, -12590.0fp, 180);
            ExitThread();
        }
        ExitThread();
    }

    actor_script actor_3 {
        SetEventHandler(EVENT_INTERACT, @label_0024);
        SpawnThread(@label_029C);
        SpawnThread(@label_0048);
        SpawnThread(@label_00EE);
        SpawnThread(@label_01FE);
