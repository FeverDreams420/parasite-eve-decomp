// Parasite Eve 1 Scene Script (room_371)
room_script room_371 {
    spawn_table { (1, 0) }

    actor_script actor_0 {
        SetEventHandler(EVENT_INTERACT, @label_001E);
        SetEventHandler(EVENT_TOUCH, @label_001A);
        Wait(1);
    @label_0016:
        ExitThread();
    @label_001A:
        ExitThread();
    @label_001E:
        GetThreadTarget14(local[3]);
        if (local[3] == 16) {
            KillOtherThreads();
            DestroySelf();
        }
        if (local[3] == 254) {
            KillOtherThreads();
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            goto @label_0016;
        }
        if (local[3] == 255) {
            KillOtherThreads();
            SetAnim(21);
            UnlockPlayerInput();
            ResumeSceneEvents();
            goto @label_0016;
        }
        ExitThread();
    }

    actor_script actor_1 {
        LockPlayerInput();
        SetMeshFadeLevel(112);
        SetCameraBaseAngle(2048, 2048);
        ClearScreenFadeFlag40();
        SetEventHandler(EVENT_INTERACT, @label_0058);
        Wait(1);
        SpawnActor(2, 0, 0.0fp, 0.0fp, 0.0fp);
        SpawnActor(3, 0, 0.0fp, 0.0fp, 0.0fp);
        SpawnActor(4, 0, 0.0fp, 0.0fp, 0.0fp);
        Wait(1);
        ExitThread();
    @label_0058:
        GetThreadTarget14(local[3]);
        if (local[3] == 27) {
            KillOtherThreads();
            Wait(70);
            OpenTextbox(20); // "Prince. Father: please give me / permission to marry Eva, <FB:07><78>"
            Wait(320);
            OpenTextbox(21); // "King. I FORBID IT!<FB:07>""
            Wait(80);
            OpenTextbox(22); // "You know well what will happen if / you do! <FB:07><55>"
            Wait(90);
            OpenTextbox(23); // "Those who succumb to her beauty ALL / die in horrible ways! <FB:07><78>"
            Wait(170);
            OpenTextbox(24); // "Prince. You don't understand!<FB:07>""
            Wait(60);
            OpenTextbox(25); // "SHE is the one that has suffered / after the deaths,<FB:07><64>"
            Wait(120);
            OpenTextbox(26); // "King. SHE is EVIL!<FB:07>""
            Wait(60);
            OpenTextbox(27); // "Guard! Grab HER!<FB:07>m"
            Wait(80);
            OpenTextbox(28); // "And,,, BURN her at the stake!<FB:07>m"
            Wait(360);
            OpenTextbox(29); // "Prince. Father!<FB:07>""
            Wait(90);
            OpenTextbox(30); // "If you are sentencing her to / death,,,<FB:07>m"
            Wait(70);
            OpenTextbox(31); // ",,,then I ask you to take my life / along with hers,,,<FB:07>m"
            Wait(110);
            OpenTextbox(32); // "Eva. Edward,,,<FB:07>m"
            AkaoCmd(0xCE, 30, 120, 0, 0, room[17]);
            Wait(120);
            AkaoCmd(0xC9, 30, 0, 0, 0, room[17]);
            ExitThread();
        }
        if (local[3] == 15) {
            KillOtherThreads();
            StartScreenFade(30);
            WaitScreenFade();
            PlayFieldSfx(2, 0, 16);
            PlayFieldSfx(3, 0, 16);
            PlayFieldSfx(4, 0, 16);
            PlayFieldSfx(5, 0, 16);
            Wait(5);
            ReloadSceneData(3);
            Noop3();
            AkaoCmd(0x199, 136, 0, 0, 0, room[17]);
            WaitSeqElapsedOrDraw(1031);
            AkaoCmd(0xCE, 31, 120, 0, 0, room[17]);
            WaitDrawIdle();
            global[AREA] = 18;
            AkaoCmd(0xC9, 31, 0, 0, 0, room[17]);
            ChangeRoom(0xA8000248);
        }
        ExitThread();
    }

