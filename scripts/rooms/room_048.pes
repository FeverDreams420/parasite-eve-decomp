// Parasite Eve 1 Scene Script (room_048)
room_script room_048 {
    spawn_table { (1, 0) }

    actor_script actor_0 {
        Wait(1);
        ExitThread();
    }

    actor_script actor_1 {
        if (global[AREA] < 746) {
            global[AREA] = 746;
        }
        LockPlayerInput();
        PauseSceneEvents();
        ClearScreenFadeFlag40();
        SetMeshFadeLevel(112);
        SceneCmd(3100, 0, 0, 0, 0, 0, 0, room[17]);
        SetCameraBaseAngle(2048, 2048);
        SetEventHandler(EVENT_INTERACT, @label_00AE);
        Wait(1);
        SpawnActor(2, 0, 0.0fp, 0.0fp, 0.0fp);
        SpawnActor(3, 0, 0.0fp, 0.0fp, 0.0fp);
        SpawnActor(4, 0, 0.0fp, 0.0fp, 0.0fp);
        if (global[AREA] == 750) {
            SpawnActor(5, 0, 0.0fp, 0.0fp, 0.0fp);
        }
        Wait(1);
        ExitThread();
    @label_00AE:
        GetThreadTarget14(local[3]);
        if (local[3] == 27) {
            Wait(70);
            OpenTextbox(20); // "Prince. Father: please give me / permission to marry Eva, <FB:07><78>"
            Wait(320);
            OpenTextbox(21); // "King. I FORBID IT!<FB:07>""
            Wait(80);
            OpenTextbox(22); // "You know well what will happen if / you do! <FB:07><55>"
            Wait(90);
            OpenTextbox(23); // "Those who succumb to her beauty ALL / die in horrible ways! <FB:07><78>"
            Wait(170);
            OpenTextbox(24); // "Prince. You don't understand!<FB:07>""
            Wait(60);
            OpenTextbox(25); // "SHE is the one that has suffered / after the deaths,<FB:07><64>"
            Wait(120);
            OpenTextbox(26); // "King. SHE is EVIL!<FB:07>""
            Wait(60);
            OpenTextbox(27); // "Guard! Grab HER!<FB:07>m"
            Wait(80);
            OpenTextbox(28); // "And,,, BURN her at the stake!<FB:07>m"
            SpawnActor(5, 0, 0.0fp, 0.0fp, 0.0fp);
            PlayFieldSfx(5, 0, 29);
            Wait(30);
            AkaoCmd(0x12C, 2800, 0, 64, 127, local[5]);
            Wait(30);
            AkaoCmd(0x12F, local[5], 0, 15, 0, room[17]);
            StartScreenFade(15);
            WaitScreenFade();
            AkaoCmd(0x12D, local[5], 0, 0, 0, room[17]);
            global[AREA] = 748;
            ChangeRoom(0xA80671C8);
        }
        if (local[3] == 28) {
            Wait(200);
            OpenTextbox(29); // "Prince. Father!<FB:07>""
            Wait(90);
            OpenTextbox(30); // "If you are sentencing her to / death,,,<FB:07>m"
            Wait(70);
            OpenTextbox(31); // ",,,then I ask you to take my life / along with hers,,,<FB:07>m"
            Wait(110);
            OpenTextbox(32); // "Eva. Edward,,,<FB:07>m"
            ExitThread();
        }
        ExitThread();
    }

