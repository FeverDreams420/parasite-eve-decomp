// Parasite Eve 1 Scene Script (room_000)
room_script room_000 {
    spawn_table { (1, 0) }

    actor_script actor_0 {
        SetHitCylinder(105, 180, 40);
        SceneCmd(2601, 136, 0, 0, 0, 0, 0, local[0]);
        SetEventHandler(EVENT_INTERACT, @label_01EA);
        SetEventHandler(EVENT_TOUCH, @label_01D4);
        SetMoveSpeed(0xCCCC);
        SetEntityVec3(VEC3_POS, -4.0fp, 65.0fp, -4813.0fp);
        SetEntityVec3(VEC3_ROT, 0, 0, 0);
        Wait(1);
        if (!(global[SCENE_FLAGS] & 2)) {
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            if (global[STORY_FLAGS] & 4) {
                OpenTextbox(7); // "Will you watch this event? / <FB:09>2 Watch / Skip"
                WaitTextbox(7);
                GetChoiceResult(local[5]);
                if (local[5] == 0) {
                } else if (local[5] == 1) {
                    global[STORY_FLAGS] = global[STORY_FLAGS] | 2;
                    goto @label_01AE;
                }
            }
            Wait(60);
            PlayFieldSfx(3, 0, 6);
            Wait(5);
            PlayFieldSfx(4, 0, 9);
            PlayFieldSfx(2, 0, 8);
            Wait(10);
            SetAnim(33);
            SetAnimFrame(0);
            PlayAnimToFrame(30);
            OpenTextbox(62); // "{Aya}. Wait! I'm a cop! I'm / with the NYPD!!"
            WaitTextbox(62);
            OpenTextbox(63); // "Cop. What?!"
            WaitTextbox(63);
            OpenTextbox(64); // "{Aya}. Hold on! I'm going to / take out my badge,,, Don't shoot,"
            WaitTextbox(64);
            SetAnim(33);
            SetAnimFrame(31);
            PlayAnimToFrame(60);
            WaitAnimEnd();
            SetAnim(32);
            SetAnimFrame(0);
            PlayAnimToFrame(140);
            WaitAnimEnd();
            Wait(30);
            PlayFieldSfx(3, 0, 10);
            Wait(10);
            PlayFieldSfx(4, 0, 13);
            PlayFieldSfx(2, 0, 12);
        @label_01AE:
            global[SCENE_FLAGS] = global[SCENE_FLAGS] | 2;
            SetAnim(21);
            UnlockPlayerInput();
            ResumeSceneEvents();
        }
        ExitThread();
    @label_01D4:
        GetThreadTargets18_1C(local[1], local[2]);
        GetAngleToActor(local[1], local[2], room[19]);
        ExitThread();
    @label_01EA:
        GetThreadTarget14(local[4]);
        if (local[4] == 254) {
            KillOtherThreads();
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
        }
        if (local[4] == 255) {
            KillOtherThreads();
            SetAnim(21);
            UnlockPlayerInput();
            ResumeSceneEvents();
        }
        if (local[4] == 1) {
            KillOtherThreads();
            PauseSceneEvents();
            LockPlayerInput();
            StartScreenFade(30);
            Wait(30);
            global[ROOM] = 1;
            ChangeRoom(0xA8067448);
        }
        if (local[4] == 3) {
            KillOtherThreads();
            SetAnim(30);
            SetAnimFrame(0);
            PlayAnimToFrame(80);
            WaitAnimEnd();
        }
        if (local[4] == 4) {
            KillOtherThreads();
            SetAnim(31);
            SetAnimFrame(0);
            PlayAnimToFrame(60);
            WaitAnimEnd();
        }
        if (local[4] == 14) {
            KillOtherThreads();
            SetAnim(29);
            SetAnimFrame(0);
            PlayAnimToFrame(54);
            WaitAnimEnd();
        }
        if (local[4] == 15) {
            KillOtherThreads();
            SetAnim(29);
            SetAnimFrame(55);
            PlayAnimToFrame(80);
            WaitAnimEnd();
            Wait(30);
            SetAnim(30);
            SetAnimFrame(0);
            PlayAnimToFrame(80);
        }
        if (local[4] == 21) {
            KillOtherThreads();
        }
        ExitThread();
    }

