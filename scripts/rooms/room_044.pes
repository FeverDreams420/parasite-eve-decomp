// Parasite Eve 1 Scene Script (room_044)
room_script room_044 {
    spawn_table { (1, 0) }

    actor_script actor_0 {
        SetHitCylinder(115, 95, 10);
        SceneCmd(2601, 128, 0, 0, 0, 0, 0, local[0]);
        SetEventHandler(EVENT_INTERACT, @label_00AA);
        SetEventHandler(EVENT_TOUCH, @label_0094);
        LockPlayerMoveMask(2);
        SetHitCylinderRadius(0x00320000);
        if (global[ROOM] == 43) {
            SetEntityVec3(VEC3_POS, 617.0fp, 0.0fp, 254.0fp);
            SetEntityVec3(VEC3_ROT, 0, 512, 0);
            goto @label_0090;
        } else {
            SetEntityVec3(VEC3_POS, 12.0fp, 0.0fp, -258.0fp);
            SetEntityVec3(VEC3_ROT, 0, 4096, 0);
            goto @label_0090;
        }
    @label_0090:
        ExitThread();
    @label_0094:
        GetThreadTargets18_1C(local[1], local[2]);
        GetAngleToActor(local[1], local[2], room[21]);
        ExitThread();
    @label_00AA:
        GetThreadTarget14(local[4]);
        if (local[4] == 0) {
            KillOtherThreads();
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            PlayFieldSfx(9, 0, 5);
            StartScreenFade(30);
            EnableActorCollision();
            SetAnim(22);
            TurnTowardPoint(951.0fp, 489.0fp, 180);
            MoveTowardPoint(951.0fp, 489.0fp, 180);
            global[ROOM] = 45;
            WaitScreenFade();
            ChangeRoom(0xA80041C8);
        }
        if (local[4] == 254) {
            KillOtherThreads();
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            goto @label_0090;
        }
        if (local[4] == 255) {
            KillOtherThreads();
            SetAnim(21);
            UnlockPlayerInput();
            ResumeSceneEvents();
            goto @label_0090;
        }
        ExitThread();
    }

    actor_script actor_1 {
