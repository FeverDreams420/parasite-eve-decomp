            SpawnActor(2, 0, 0.0fp, 0.0fp, 0.0fp);
            SpawnActor(3, 0, 0.0fp, 0.0fp, 0.0fp);
        } else if (global[44] & 128) {
            SetGeomFlagSlot(0, 1);
            SetGeomEntryLimit(0, 5);
            SetGeomEntryField8(0, 0);
        } else {
            SpawnActor(6, 0, 0.0fp, 0.0fp, 0.0fp);
        }
        if (global[44] & 256) {
            SetGeomFlagSlot(1, 1);
            SetGeomEntryLimit(1, 5);
            SetGeomEntryField8(1, 0);
        } else {
            SpawnActor(7, 0, 0.0fp, 0.0fp, 0.0fp);
        }
        if (global[44] & 512) {
            SetGeomFlagSlot(2, 1);
            SetGeomEntryLimit(2, 5);
            SetGeomEntryField8(2, 0);
        } else {
            SpawnActor(8, 0, 0.0fp, 0.0fp, 0.0fp);
        }
        Wait(1);
        SetFadeColor(0x1E);
        PlayFieldSfx(0, 0, 255);
        ExitThread();
    }

    actor_script actor_2 {
