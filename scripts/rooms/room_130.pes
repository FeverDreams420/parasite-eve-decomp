// Parasite Eve 1 Scene Script (room_130)
room_script room_130 {
    spawn_table { (1, 0) }

    actor_script actor_0 {
        SetHitCylinder(115, 65, 10);
        SceneCmd(2601, 128, 0, 0, 0, 0, 0, local[0]);
        SetEventHandler(EVENT_INTERACT, @label_00D4);
        PauseSceneEvents();
        LockPlayerInput();
        StopActorMotion();
        SetAnim(21);
        SetEntityVec3(VEC3_POS, -1640.0fp, 0.0fp, -350.0fp);
        SetEntityVec3(VEC3_ROT, 0, 2048, 0);
        Wait(15);
        SetAnim(22);
        TurnTowardPoint(-1600.0fp, -100.0fp, 128);
        MoveTowardPoint(-1600.0fp, -100.0fp, 128);
        SetAnim(21);
        OpenTextbox(33); // "Eve. Night: night,,, / Don't let the bed bugs bite,"
        WaitTextbox(33);
        PlayFieldSfx(2, 0, 1);
        SetAnim(23);
        TurnTowardPoint(-2400.0fp, 0.0fp, 128);
        SetAnim(21);
        OpenTextbox(100); // "{Aya}. The power!"
        SetAnim(33);
        SetAnimFrame(0);
        PlayAnimToFrame(70);
        WaitAnimEnd();
        WaitTextbox(100);
        SetAnim(29);
        Wait(1);
    @label_00D0:
        ExitThread();
    @label_00D4:
        GetThreadTarget14(local[3]);
        if (local[3] == 254) {
            KillOtherThreads();
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            goto @label_00D0;
        }
        if (local[3] == 255) {
            KillOtherThreads();
            SetAnim(21);
            UnlockPlayerInput();
            ResumeSceneEvents();
            goto @label_00D0;
        }
        ExitThread();
        ExitThread();
    }

    actor_script actor_1 {
        AkaoCmd(0x193, 1020, 1016, 0, 0, room[17]);
        LockPlayerInput();
        SetCameraBaseAngle(3072, 3072);
        EnablePlayerMovement();
        SetEventHandler(EVENT_INTERACT, @label_0062);
        LockPlayerInput();
        ClearScreenFadeFlag40();
        SpawnActor(0, 0, 0.0fp, 0.0fp, 0.0fp);
        SpawnActor(2, 0, 0.0fp, 0.0fp, 0.0fp);
        Wait(1);
        SetFadeColor(0x1E);
        Wait(1);
    @label_005E:
        ExitThread();
    @label_0062:
        GetThreadTarget14(local[3]);
        if (local[3] == 252) {
            PlayFieldSfx(2, 0, 251);
            goto @label_005E;
        }
        if (local[3] == 253) {
            SpawnActor(2, 0, 0.0fp, 0.0fp, 0.0fp);
            goto @label_005E;
        }
        ExitThread();
        ExitThread();
    }

    actor_script actor_2 {
        SetEventHandler(EVENT_INTERACT, @label_0136);
        Wait(1);
        SetGeomFlagSlot(0, 1);
        SetGeomEntryLimit(0, 0);
        SetGeomEntryField8(0, 0);
        SetGeomFlagSlot(1, 1);
        SetGeomEntryLimit(1, 1);
        SetGeomEntryField8(1, 0);
        SetGeomFlagSlot(2, 1);
        SetGeomEntryLimit(2, 1);
        SetGeomEntryField8(2, 0);
        ExitThread();
    @label_005A:
        GetThreadId(local[6]);
        Random(local[8], 0, 3);
        if (local[8] == local[10]) {
            goto @label_005A;
        }
        SetGeomFlagSlot(0, 1);
        SetGeomEntryLimit(0, local[8]);
        SetGeomEntryField8(0, 0);
        local[10] = local[8];
        Random(local[9], 4, 6);
        Wait(local[9]);
        goto @label_005A;
    @label_00BA:
        GetThreadId(local[7]);
        Random(local[11], 0, 5);
        if (local[11] == local[13]) {
            goto @label_00BA;
        }
        SetGeomFlagSlot(1, 1);
        SetGeomEntryLimit(1, local[11]);
        SetGeomEntryField8(1, 0);
        SetGeomFlagSlot(2, 1);
        SetGeomEntryLimit(2, local[11]);
        SetGeomEntryField8(2, 0);
        local[13] = local[11];
        Random(local[12], 2, 5);
        Wait(local[12]);
        goto @label_00BA;
        ExitThread();
    @label_0136:
        GetThreadTarget14(local[5]);
        if (local[5] == 1) {
            AkaoCmd(0x12C, 2461, 0, 128, 127, room[17]);
            SpawnThread(@label_00BA);
            Wait(15);
            SpawnThread(@label_005A);
            Wait(90);
            KillThread(local[6]);
            SetGeomFlagSlot(0, 1);
            SetGeomEntryLimit(0, 3);
            SetGeomEntryField8(0, 0);
            KillThread(local[7]);
            SetGeomFlagSlot(1, 1);
            SetGeomEntryLimit(1, 1);
            SetGeomEntryField8(1, 0);
            SetGeomFlagSlot(2, 1);
            SetGeomEntryLimit(2, 1);
            SetGeomEntryField8(2, 0);
            global[AREA] = 470;
            StartScreenFade(10);
            WaitScreenFade();
            AkaoCmd(0x13A, 0, 0, 0, 0, room[17]);
            global[ROOM] = 131;
            ChangeRoom(0xA8062048);
            ExitThread();
        }
        ExitThread();
        ExitThread();
    }
}
