    actor_script actor_2 {
        AkaoCmd(0xC8, 8, 0, 0, 0, local[0]);
        if (!(global[47] & 0x01000000)) {
            AkaoCmd(0xCD, 8, 69, 0, 0, local[0]);
            AkaoCmd(0xD0, -48, 0, 0, 0, local[0]);
        }
        ClearScreenFadeFlag40();
        SpawnActor(1, 0, 0.0fp, 0.0fp, 0.0fp);
        SetEventHandler(EVENT_INTERACT, @label_016A);
        Wait(1);
        SetGeomEntryVisible(10, 1);
        SetGeomEntryVisible(9, 1);
        SetGeomEntryVisible(8, 0);
        SetGeomEntryVisible(7, 0);
        SetGeomEntryVisible(6, 0);
        SetGeomEntryVisible(5, 0);
        SetGeomEntryVisible(4, 0);
        SetGeomEntryVisible(3, 0);
        SetGeomEntryVisible(2, 0);
        SetGeomEntryVisible(1, 0);
        SetGeomEntryVisible(0, 0);
        SetFadeColor(0x1E);
        WaitScreenFade();
        Wait(5);
        if (!(global[47] & 0x01000000)) {
            AkaoCmd(0x12C, 1110, 0, 128, 123, local[4]);
            SetGeomEntryVisible(0, 1);
            SetGeomEntryVisible(5, 1);
            PlayFieldSfx(1, 0, 1);
        }
        if (global[47] & 0x01000000) {
            AkaoCmd(0x12C, 1110, 0, 128, 123, local[4]);
            SetGeomEntryVisible(2, 1);
            SetGeomEntryVisible(7, 1);
            PlayFieldSfx(1, 0, 2);
        }
        Wait(1);
        ExitThread();
    @label_016A:
        GetThreadTarget14(local[5]);
        ExitThread();
        while (1) {
            CheckPadInput(PAD_PRESSED, 0x20000000, local[13]);
            if (local[13] != 0) {
                StartScreenFade(3);
                ExitThread();
            }
            Wait(1);
