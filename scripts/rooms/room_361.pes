// Parasite Eve 1 Scene Script (room_361)
room_script room_361 {
    spawn_table { (2, 0) }

    actor_script actor_0 {
        DestroySelf();
    }

    actor_script actor_1 {
        SetEventHandler(EVENT_INTERACT, @label_0010);
        PauseSceneEvents();
        ExitThread();
    @label_0010:
        GetThreadTarget14(local[5]);
        if (local[5] == 1) {
            room[19] = 0;
            SpawnThread(@label_03B2);
            SpawnThread(@label_0130);
            SpawnThread(@label_00BA);
        }
        if (local[5] == 2) {
            room[19] = 2;
            SpawnThread(@label_03B2);
            SpawnThread(@label_0070);
        }
        ExitThread();
    @label_0070:
        while (1) {
            CheckPadInput(PAD_PRESSED, 0x40000000, local[2]);
            if (local[2] != 0) {
                StartScreenFade(30);
                WaitScreenFade();
                global[ROOM] = 362;
                ChangeRoom(0xA8005148);
            }
            Wait(1);
        }
    @label_00BA:
        while (1) {
            CheckPadInput(PAD_PRESSED, 2, local[2]);
            if (local[2] != 0) {
                AkaoCmd(0xCE, 8, 15, 0, 0, local[4]);
                StartScreenFade(15);
                WaitScreenFade();
                AkaoCmd(0xD0, 0, 0, 0, 0, local[4]);
                AkaoCmd(0xC9, 8, 0, 0, 0, local[4]);
                ChangeRoom(0xA9400048);
                ExitThread();
            }
            Wait(1);
        }
    @label_0130:
        while (1) {
            CheckPadInput(PAD_PRESSED, 0x80000000, local[2]);
            if (local[2] != 0) {
                AkaoCmd(0x12C, 1102, 0, 128, 123, local[3]);
                room[19] = room[19] - 1;
                if (room[19] < 0) {
                    StartScreenFade(30);
                    WaitScreenFade();
                    ChangeRoom(0xA80660C8);
                }
                if (room[19] == 4) {
                    Wait(1);
                    SetGeomEntryVisible(0, 0);
                    SetGeomEntryVisible(1, 0);
                    SetGeomEntryVisible(2, 0);
                    SetGeomEntryVisible(3, 0);
                    SetGeomEntryVisible(4, 1);
                    SetGeomEntryVisible(5, 0);
                    SetGeomEntryVisible(6, 0);
                    SetGeomEntryVisible(7, 0);
                    SetGeomEntryVisible(8, 1);
                    Wait(2);
                }
                if (room[19] == 3) {
                    Wait(1);
                    SetGeomEntryVisible(0, 0);
                    SetGeomEntryVisible(1, 0);
                    SetGeomEntryVisible(2, 0);
                    SetGeomEntryVisible(3, 1);
                    SetGeomEntryVisible(4, 0);
                    SetGeomEntryVisible(5, 0);
                    SetGeomEntryVisible(6, 0);
                    SetGeomEntryVisible(7, 1);
                    SetGeomEntryVisible(8, 0);
                    Wait(2);
                }
                if (room[19] == 2) {
                    Wait(1);
                    SetGeomEntryVisible(0, 0);
                    SetGeomEntryVisible(1, 0);
                    SetGeomEntryVisible(2, 1);
                    SetGeomEntryVisible(3, 0);
                    SetGeomEntryVisible(4, 0);
                    SetGeomEntryVisible(5, 0);
                    SetGeomEntryVisible(6, 0);
                    SetGeomEntryVisible(7, 1);
                    SetGeomEntryVisible(8, 0);
                    Wait(2);
                }
                if (room[19] == 1) {
                    Wait(1);
                    SetGeomEntryVisible(0, 0);
                    SetGeomEntryVisible(1, 1);
                    SetGeomEntryVisible(2, 0);
                    SetGeomEntryVisible(3, 0);
                    SetGeomEntryVisible(4, 0);
                    SetGeomEntryVisible(5, 0);
                    SetGeomEntryVisible(6, 1);
                    SetGeomEntryVisible(7, 0);
                    SetGeomEntryVisible(8, 0);
                    Wait(2);
                }
                if (room[19] == 0) {
                    Wait(1);
                    SetGeomEntryVisible(0, 1);
                    SetGeomEntryVisible(1, 0);
                    SetGeomEntryVisible(2, 0);
                    SetGeomEntryVisible(3, 0);
                    SetGeomEntryVisible(4, 0);
                    SetGeomEntryVisible(5, 1);
                    SetGeomEntryVisible(6, 0);
                    SetGeomEntryVisible(7, 0);
                    SetGeomEntryVisible(8, 0);
                    Wait(2);
                }
            }
            Wait(1);
        }
    @label_03B2:
        while (1) {
            CheckPadInput(PAD_PRESSED, 0x20000000, local[2]);
            if (local[2] != 0) {
                AkaoCmd(0x12C, 1102, 0, 128, 123, local[3]);
                room[19] = room[19] + 1;
                if (room[19] >= 5) {
                    StartScreenFade(30);
                    WaitScreenFade();
                    ChangeRoom(0xA80651C8);
                }
                if (room[19] == 4) {
                    if (global[47] & 0x01000000) {
                        StartScreenFade(30);
                        WaitScreenFade();
                        global[ROOM] = 362;
                        ChangeRoom(0xA8005148);
