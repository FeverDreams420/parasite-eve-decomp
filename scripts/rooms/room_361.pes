                if (room[19] == 2) {
                    Wait(1);
                    SetGeomEntryVisible(0, 0);
                    SetGeomEntryVisible(1, 0);
                    SetGeomEntryVisible(2, 1);
                    SetGeomEntryVisible(3, 0);
                    SetGeomEntryVisible(4, 0);
                    SetGeomEntryVisible(5, 0);
                    SetGeomEntryVisible(6, 0);
                    SetGeomEntryVisible(7, 1);
                    SetGeomEntryVisible(8, 0);
                    Wait(2);
                }
                if (room[19] == 1) {
                    Wait(1);
                    SetGeomEntryVisible(0, 0);
                    SetGeomEntryVisible(1, 1);
                    SetGeomEntryVisible(2, 0);
                    SetGeomEntryVisible(3, 0);
                    SetGeomEntryVisible(4, 0);
                    SetGeomEntryVisible(5, 0);
                    SetGeomEntryVisible(6, 1);
