                } else {
                    goto @label_0168;
                }
            @label_0168:
                Wait(30);
                OpenTextbox(124); // "Daniel. Ah: ahem,,,ah: people,,,"
                SetAnim(3);
                SetAnimFrame(0);
                PlayAnimToFrame(59);
                WaitAnimEnd();
                WaitTextbox(124);
                PlayFieldSfx(0, 0, 2);
                OpenTextbox(125); // "{Aya}. C'mon: Daniel, You're in / charge now,"
                WaitTextbox(125);
                while (room[18] == 0) {
                    Wait(1);
                }
                room[18] = room[18] - 1;
                OpenTextbox(126); // "Daniel. Yeah: well,,, I'm not used / to this sorta thing,,,"
                SetAnim(9);
                SetAnimFrame(0);
                PlayAnimToFrame(59);
                WaitAnimEnd();
                WaitTextbox(126);
                PlayFieldSfx(3, 0, 2);
                OpenTextbox(127); // "Warner. You're doin' great: boss!"
                WaitTextbox(127);
                while (room[19] == 0) {
                    Wait(1);
                }
                room[19] = room[19] - 1;
                OpenTextbox(128); // "Daniel. But why did Eve decide to / attack the precinct,,,?"
                SetAnim(10);
                SetAnimFrame(0);
                PlayAnimToFrame(29);
                WaitAnimEnd();
                WaitTextbox(128);
                PlayFieldSfx(0, 0, 3);
                OpenTextbox(129); // "{Aya}. To get rid of us,,,?"
                WaitTextbox(129);
                while (room[18] == 0) {
                    Wait(1);
                }
                room[18] = room[18] - 1;
                PlayFieldSfx(4, 0, 2);
                OpenTextbox(130); // "Cop. Maybe that Japanese guy knows / something about it,"
                WaitTextbox(130);
                while (room[20] == 0) {
                    Wait(1);
                }
                room[20] = room[20] - 1;
                OpenTextbox(131); // "Daniel. You're right, Where'd he / go: anyway?"
                SetAnim(4);
                SetAnimFrame(0);
                PlayAnimToFrame(69);
                WaitAnimEnd();
                WaitTextbox(131);
            @label_031E:
                PlayFieldSfx(0, 0, 255);
                global[AREA] = 440;
                global[44] = global[44] | 0x00100000;
            }
        }
        ExitThread();
    @label_0348:
        GetThreadTargets18_1C(local[1], local[2]);
        if (local[1] == 0) {
            if (room[17] == 0) {
                CheckPadInput(PAD_PRESSED, 0x100, local[3]);
