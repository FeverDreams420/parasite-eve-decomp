// Parasite Eve 1 Scene Script (room_123)
room_script room_123 {
    spawn_table { (1, 0) }

    actor_script actor_0 {
        SetHitCylinder(115, 85, 10);
        SceneCmd(2601, 128, 0, 0, 0, 0, 0, local[0]);
        SetEventHandler(EVENT_INTERACT, @label_00A0);
        SetEventHandler(EVENT_TOUCH, @label_009C);
        if (global[AREA] >= 432) {
            LockPlayerMoveMask(2);
        }
        if (global[ROOM] == 122) {
            SetEntityVec3(VEC3_POS, 1869.0fp, 348.0fp, 83.0fp);
            SetEntityVec3(VEC3_ROT, 0, 1024, 0);
        } else {
            SetEntityVec3(VEC3_POS, 1151.0fp, 0.0fp, 83.0fp);
            SetEntityVec3(VEC3_ROT, 0, 1024, 0);
            goto @label_0098;
        }
    @label_0098:
        ExitThread();
    @label_009C:
        ExitThread();
    @label_00A0:
        GetThreadTarget14(local[4]);
        if (local[4] == 0) {
            KillOtherThreads();
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            EnableActorCollision();
            SetAnim(22);
            TurnTowardPoint(-1060.0fp, -17.0fp, 45);
            SetAnim(31);
            SetAnimFrame(0);
            PlayAnimToFrame(17);
            WaitAnimEnd();
            SetAnim(32);
            AkaoCmd(0x15F, 2409, 0, 0, 0, room[18]);
            SetGeomFlagSlot(1, 1);
            SetMenuSlotEntry(1, 0, 5);
            StartScreenFade(30);
            MoveTowardPoint(-992.0fp, 10.0fp, 45);
            WaitScreenFade();
            global[ROOM] = 124;
            ChangeRoom(0xA8004248);
        }
        if (local[4] == 1) {
            KillOtherThreads();
            PauseSceneEvents();
            LockPlayerInput();
            StartScreenFade(30);
            WaitScreenFade();
            global[ROOM] = 124;
            ChangeRoom(0xA8022148);
        }
        if (local[4] == 254) {
            KillOtherThreads();
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            goto @label_0098;
        }
        if (local[4] == 255) {
            KillOtherThreads();
            SetAnim(21);
            UnlockPlayerInput();
            ResumeSceneEvents();
            goto @label_0098;
        }
        if (local[4] == 2) {
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            SetAnim(22);
            TurnTowardPoint(1152.0fp, 222.0fp, 45);
            SetAnim(29);
            SetAnimFrame(0);
            PlayAnimToFrame(38);
            WaitAnimEnd();
            OpenTextbox(82); // "{Aya}. It's the same stuff from / the kennel,,,"
            SetAnim(30);
            SetAnimFrame(0);
            PlayAnimToFrame(83);
            WaitAnimEnd();
            WaitTextbox(82);
            SetAnim(29);
            SetAnimFrame(38);
            PlayAnimToFrame(77);
            WaitAnimEnd();
            SetAnim(21);
            UnlockPlayerInput();
            ResumeSceneEvents();
        }
        ExitThread();
    }

    actor_script actor_1 {
        AkaoCmd(0x193, 1002, 1002, 0, 0, room[18]);
        LockPlayerInput();
        SetMeshFadeLevel(88);
        ClearScreenFadeFlag40();
        if (global[AREA] >= 392) {
            if (global[AREA] < 432) {
                if (global[44] & 2048) {
                    if (global[46] & 4) {
                        AkaoCmd(0xC8, 41, 0, 0, 0, room[18]);
                        AkaoCmd(0x190, 41, 0, 0, 0, room[18]);
                    } else {
                        AkaoCmd(0xC8, 15, 0, 0, 0, room[18]);
                        AkaoCmd(0x190, 15, 0, 0, 0, room[18]);
                    }
                } else {
                    AkaoCmd(0xC8, 10, 0, 0, 0, room[18]);
                    AkaoCmd(0x190, 39, 0, 0, 0, room[18]);
                }
            } else if (global[46] & 16384) {
                AkaoCmd(0xC8, 8, 0, 0, 0, room[18]);
            }
        }
        SetCameraBaseAngle(3040, 3040);
        SetGeomEntryPos(0, 0, 0, 100);
        DisableCollisionTriangle(21);
        DisableCollisionTriangle(22);
        SpawnActor(2, 0, 0.0fp, 0.0fp, 0.0fp);
        SpawnActor(0, 0, 0.0fp, 0.0fp, 0.0fp);
        Wait(1);
        SetFadeColor(0x1E);
        PlayFieldSfx(0, 0, 255);
        ExitThread();
    }

    actor_script actor_2 {
        Wait(1);
        while (1) {
            GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
            TestPointInQuad(-987.0fp, -100.0fp, -987.0fp, 107.0fp, -805.0fp, 107.0fp, -805.0fp, -100.0fp, local[0], local[2], local[4]);
            if (local[4] == 1) {
                if (global[AREA] < 432) {
                    PlayFieldSfx(0, 0, 0);
                    DestroySelf();
                } else {
                    GetActorPositionByType(5, 0, 0, local[3], local[7], local[3], local[3]);
                    if (local[7] > 4064 || local[7] < 2016) {
                        if (local[6] == 0) {
                            local[6] = 1;
                            PauseSceneEvents();
                            PlayFieldSfx(0, 0, 254);
                            OpenTextbox(154); // "Restricted / Do Not Enter / Captain Dollis"
                            WaitTextbox(154);
                            PlayFieldSfx(0, 0, 255);
                        }
                    }
                }
            } else {
                local[6] = 0;
            }
            GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
            TestPointInQuad(2355.0fp, 522.0fp, 1760.0fp, -320.0fp, 1829.0fp, -320.0fp, 2412.0fp, 507.0fp, local[0], local[2], local[4]);
            if (local[4] == 1) {
                PlayFieldSfx(0, 0, 1);
                DestroySelf();
            }
            if (global[AREA] < 432) {
                GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
                TestPointInQuad(1258.0fp, 22.0fp, 1258.0fp, 410.0fp, 740.0fp, 410.0fp, 740.0fp, 22.0fp, local[0], local[2], local[4]);
                if (local[4] == 1) {
                    GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
                    TestPointInQuad(1243.0fp, 145.0fp, 1243.0fp, 304.0fp, 986.0fp, 304.0fp, 986.0fp, 145.0fp, local[0], local[2], local[4]);
                    if (local[4] == 0) {
                        CheckPadInput(PAD_PRESSED, 0x100, local[5]);
                        if (local[5] != 0) {
                            if (!(global[44] & 0x00080000)) {
                                PlayFieldSfx(0, 0, 2);
                                global[44] = global[44] | 0x00080000;
                            }
                        }
                    }
                }
            }
            Wait(1);
        }
    }
}
