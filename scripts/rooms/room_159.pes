        LockPlayerMoveMask(2);
        if (global[ROOM] == 125) {
            SetEntityVec3(VEC3_POS, -1700.0fp, -1000.0fp, -500.0fp);
            SetEntityVec3(VEC3_ROT, 0, 0, 0);
            goto @label_0218;
        } else {
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            SetEntityVec3(VEC3_POS, -1670.0fp, -3.0fp, -1050.0fp);
            SetEntityVec3(VEC3_ROT, 0, 0, 0);
            EnableActorCollision();
            SetActorFlag400();
            SetGeomEntryVisible(2, 1);
            SetGeomEntryVisible(5, 1);
            SetGeomEntryPos(2, 0, 84, 50);
            SetGeomEntryPos(5, 0, 84, 50);
            SetEntityVec3(VEC3_POS, -2100.0fp, -742.0fp, -525.0fp);
            SetEntityVec3(VEC3_ROT, 0, 1024, 0);
            SetAnim(35);
            SetAnimFrame(100);
            PlayAnimToFrame(204);
            WaitAnimEnd();
            SetMoveFactor(0x30000);
            SetAnim(23);
            TurnTowardPoint(-1700.0fp, -500.0fp, 128);
            MoveTowardPoint(-1700.0fp, -500.0fp, 128);
            SetMoveFactor(0x10000);
            SetAnim(22);
            TurnTowardPoint(-1700.0fp, -2000.0fp, 64);
            SetAnim(21);
            Wait(10);
            SetEntityVec3(VEC3_POS, -1700.0fp, -30.0fp, -500.0fp);
            SetEntityVec3(VEC3_ROT, 0, 0, 0);
            SetRenderFlagsC0();
            SetScrollMode(160, 121, 20);
            ClearRenderFlagsC0();
            SetAnim(34);
            SetAnimFrame(0);
            PlayAnimToFrame(124);
            WaitAnimEnd();
            ClearActorFlag400();
            SetRenderFlagsC0();
            SetScrollMode(160, 261, 30);
            PlayFieldSfx(2, 0, 3);
            AkaoCmd(0x15F, 2504, 0, 0, 0, room[17]);
            SetAnim(34);
            SetAnimFrame(125);
            PlayAnimToFrame(197);
            WaitAnimEnd();
            room[19] = 1;
            Wait(1);
            SetEntityVec3(VEC3_POS, -1670.0fp, -3.0fp, -1050.0fp);
            SetAnim(21);
            SetEntityVec3(VEC3_ROT, 0, 0, 0);
            Wait(10);
            DisableActorCollision();
            SetAnim(29);
            SetAnimFrame(0);
            PlayAnimToFrame(80);
            WaitAnimEnd();
            room[18] = 0;
            goto @label_0218;
        }
        Wait(1);
    @label_0218:
        ExitThread();
    @label_021C:
        GetThreadTarget14(local[3]);
        if (local[3] == 254) {
            KillOtherThreads();
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            goto @label_0218;
        }
        if (local[3] == 255) {
            KillOtherThreads();
            SetAnim(21);
            UnlockPlayerInput();
            ResumeSceneEvents();
            goto @label_0218;
        }
        if (local[3] == 5) {
            SetAnim(22);
            SetMoveFactor(0xF0000);
            CameraSnapToActor(2, 0, 64);
            SetMoveFactor(0x10000);
            SetAnim(21);
            SetAnim(33);
            OpenTextbox(112); // "{Aya}. We don't have any time! / Eve got away with a sperm sample,"
            WaitTextbox(112);
            SetAnim(21);
            Wait(60);
            StartScreenFade(30);
            WaitScreenFade();
            global[AREA] = 520;
            AkaoCmd(0x13A, 0, 0, 0, 0, room[17]);
            AkaoCmd(0xD9, 0, 0, 0, 0, room[17]);
            global[ROOM] = 160;
            ChangeRoom(0xA80032C8);
            ExitThread();
        }
        ExitThread();
        ExitThread();
    }

    actor_script actor_1 {
