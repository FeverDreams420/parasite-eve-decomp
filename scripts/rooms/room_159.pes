        Wait(1);
        goto @label_009E;
    @label_0112:
        GetThreadTarget14(local[8]);
        if (local[8] == 252) {
            PlayFieldSfx(4, 0, 251);
            ExitThread();
        }
        if (local[8] == 253) {
            SpawnActor(4, 0, 0.0fp, 0.0fp, 0.0fp);
            ExitThread();
        }
        if (local[8] == 3) {
            OpenTextbox(111); // "Daniel. Over here Maeda!"
            WaitTextbox(111);
            PlayFieldSfx(3, 0, 4);
            OpenTextbox(77); // "Maeda. {Aya}!"
            WaitTextbox(77);
            while (room[18] == 1) {
                Wait(1);
            }
            PlayFieldSfx(0, 0, 5);
            ExitThread();
        }
        ExitThread();
        ExitThread();
    }

