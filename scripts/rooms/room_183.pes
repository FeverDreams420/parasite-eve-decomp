                            global[87] = global[87] & -257;
                        }
                    }
                } else {
                    AkaoCmd(0x15F, 1113, 0, 0, 0, local[6]);
                    SetAnim(1);
                    SetAnimFrame(0);
                    PlayAnimToFrame(30);
                    WaitAnimEnd();
                    global[87] = global[87] | 256;
                    if (global[200] == 0) {
                        local[9] = local[0];
                    } else {
                        local[9] = global[200];
                    }
                    GiveItem(local[9], local[8]);
                    if (local[8] == 0) {
                        ShowReceivedItemPopup(local[9]);
                        global[200] = 0;
                    } else {
                        OpenTextbox(3); // "Your inventory is full, | Would you like to exchange items? / <FB:09>2 Yes / No"
                        WaitTextbox(3);
                        GetChoiceResult(local[6]);
                        if (local[6] == 0) {
                            RunSubSceneWithTimeout(local[9], local[8]);
                            if (local[8] != -1) {
                                ShowReceivedItemPopup(local[9]);
                                global[200] = local[8];
                            }
                            Wait(1);
                        }
                        AkaoCmd(0x15F, 1114, 0, 0, 0, local[6]);
                        SetAnim(3);
                        SetAnimFrame(0);
                        PlayAnimToFrame(30);
                        WaitAnimEnd();
                        global[87] = global[87] & -257;
                    }
                }
                PlayFieldSfx(0, 0, 255);
            }
        }
        ExitThread();
    }
}
