// Parasite Eve 1 Scene Script (room_150)
room_script room_150 {
    spawn_table { (1, 0) }

    actor_script actor_0 {
        SetHitCylinder(85, 80, 20);
        SceneCmd(2601, 128, 0, 0, 0, 0, 0, local[0]);
        SetEventHandler(EVENT_INTERACT, @label_0086);
        if (global[ROOM] == 150) {
            SetEntityVec3(VEC3_POS, -50.0fp, 0.0fp, 1700.0fp);
            SetEntityVec3(VEC3_ROT, 0, 2048, 0);
            goto @label_0082;
        } else {
            SetEntityVec3(VEC3_POS, -50.0fp, 0.0fp, 1700.0fp);
            SetEntityVec3(VEC3_ROT, 0, 0, 0);
            goto @label_0082;
        }
        Wait(1);
    @label_0082:
        ExitThread();
    @label_0086:
        GetThreadTarget14(local[3]);
        if (local[3] == 254) {
            KillOtherThreads();
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            goto @label_0082;
        }
        if (local[3] == 255) {
            KillOtherThreads();
            SetAnim(21);
            UnlockPlayerInput();
            ResumeSceneEvents();
            goto @label_0082;
        }
        if (local[3] == 1) {
            KillOtherThreads();
            PauseSceneEvents();
            LockPlayerInput();
            StartScreenFade(30);
            WaitScreenFade();
            global[ROOM] = 151;
            ChangeRoom(0xA8025048);
            ExitThread();
        }
        ExitThread();
        ExitThread();
    }

    actor_script actor_1 {
        AkaoCmd(0x193, 1016, 1020, 0, 0, room[17]);
        AkaoCmd(0xC8, 9, 0, 0, 0, room[17]);
        LockPlayerInput();
        SetCameraBaseAngle(0, 0);
        EnablePlayerMovement();
        ClearScreenFadeFlag40();
        SpawnActor(0, 0, 0.0fp, 0.0fp, 0.0fp);
        SpawnActor(2, 0, 0.0fp, 0.0fp, 0.0fp);
        SpawnActor(3, 0, 0.0fp, 0.0fp, 0.0fp);
        SpawnActor(4, 0, 0.0fp, 0.0fp, 0.0fp);
        Wait(1);
        SetFadeColor(0x1E);
        PlayFieldSfx(0, 0, 255);
        Wait(1);
    @label_0088:
        ExitThread();
        goto @label_0088;
        ExitThread();
    }

    actor_script actor_2 {
        SetHitCylinder(5, 10, 25);
        DisableActorRendering();
        EnableActorCollision();
        SetEntityVec3(VEC3_POS, -50.0fp, 0.0fp, 1700.0fp);
        LoadRoomAssets(69, local[0]);
        SendPmCommand0(local[0], 0, 0, 0, 0);
        SendPmCommand0(local[0], 1, -350, 1900, 0);
        SendPmCommand0(local[0], 2, 350, 1800, 0);
        HideActor();
        SendPmCommand0(local[0], 3, 1, 0, 0);
        Wait(1);
        ExitThread();
    }

    actor_script actor_3 {
        local[0] = 0;
        Wait(1);
        SpawnThread(@label_0018);
        ExitThread();
    @label_0018:
        while (local[0] <= 11) {
            SetGeomFlagSlot(0, 1);
            SetGeomEntryLimit(0, local[0]);
            SetGeomEntryField8(0, 0);
            Wait(4);
            local[0] = local[0] + 1;
            if (local[0] == 12) {
                local[0] = 0;
            }
        }
        goto @label_0018;
        ExitThread();
    }

    actor_script actor_4 {
        Wait(1);
        SpawnThread(@label_0010);
        ExitThread();
    @label_0010:
        GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
        TestPointInQuad(-250.0fp, 1550.0fp, -250.0fp, 1400.0fp, 250.0fp, 1400.0fp, 250.0fp, 1550.0fp, local[0], local[2], local[4]);
        if (local[4] == 1) {
            PlayFieldSfx(0, 0, 1);
            ExitThread();
        }
        Wait(1);
        goto @label_0010;
        ExitThread();
    }
}
