        }
        if (local[3] == 255) {
            KillOtherThreads();
            SetAnim(21);
            UnlockPlayerInput();
            ResumeSceneEvents();
            goto @label_00E6;
        }
        if (local[3] == 1) {
            KillOtherThreads();
