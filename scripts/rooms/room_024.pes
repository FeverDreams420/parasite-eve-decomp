        WaitScreenFade();
        AkaoCmd(0xC9, 5, 0, 0, 0, room[17]);
        ChangeRoom(0xA80671C8);
        ExitThread();
    @label_045A:
        ExitThread();
    @label_045E:
        GetThreadTarget14(local[4]);
        if (local[4] == 254) {
            KillOtherThreads();
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
        }
        if (local[4] == 255) {
            KillOtherThreads();
            SetAnim(21);
            UnlockPlayerInput();
            ResumeSceneEvents();
        }
        ExitThread();
    }

