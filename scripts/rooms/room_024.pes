        PlayFieldSfx(3, 0, 0);
        while (room[20] == 0) {
            Wait(1);
        }
        room[20] = room[20] - 1;
        SpawnThread(@label_03E6);
        PlayFieldSfx(2, 0, 7);
        OpenTextbox(161); // "Daniel. I,,, I'm not too good with / these social events,,,"
        Wait(100);
        CloseTextbox(161);
        while (room[20] == 0) {
            Wait(1);
        }
        room[20] = room[20] - 1;
        while (room[21] == 0) {
            Wait(1);
        }
        room[21] = room[21] - 1;
        PlayFieldSfx(2, 0, 1);
        OpenTextbox(162); // "Ben. Nah: not me! I love these / things!"
        Wait(100);
        CloseTextbox(162);
        while (room[21] == 0) {
            Wait(1);
        }
        room[21] = room[21] - 1;
        SetAnim(22);
        CameraSnapToActor(3, 0, 45);
        OpenTextbox(163); // "{Aya}. We have to make up for / Christmas Eve,"
        SetAnim(31);
        SetAnimFrame(0);
        PlayAnimToFrame(79);
        WaitAnimEnd();
        Wait(10);
        CloseTextbox(163);
        PlayFieldSfx(3, 0, 2);
        while (room[20] == 0) {
            Wait(1);
        }
        room[20] = room[20] - 1;
        PlayFieldSfx(4, 0, 0);
        PlayFieldSfx(2, 0, 5);
        SpawnThread(@label_0400);
        while (room[23] == 0) {
            Wait(1);
        }
        room[23] = room[23] - 1;
        OpenTextbox(164); // "Maeda. This is my first time: so,,, / I'm,,, mmm,,, I'm nervous,,,"
        Wait(100);
        CloseTextbox(164);
        while (room[23] == 0) {
            Wait(1);
        }
        room[23] = room[23] - 1;
        while (room[21] == 0) {
            Wait(1);
        }
        room[21] = room[21] - 1;
        PlayFieldSfx(2, 0, 3);
        while (room[21] == 0) {
            Wait(1);
        }
        room[21] = room[21] - 1;
        OpenTextbox(165); // "Ben. That's 'cuz you're with / {Aya} and she's all dressed up / and pretty,"
        Wait(100);
        CloseTextbox(165);
        while (room[21] == 0) {
            Wait(1);
        }
        room[21] = room[21] - 1;
        PlayFieldSfx(4, 0, 4);
        OpenTextbox(166); // "Maeda. What?! No!: NO! That's not / it! Of course not!"
        Wait(60);
        CloseTextbox(166);
        while (room[23] == 0) {
            Wait(1);
        }
        room[23] = room[23] - 1;
        OpenTextbox(167); // "{Aya}. It's starting, Shall we?"
