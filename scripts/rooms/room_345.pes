// Parasite Eve 1 Scene Script (room_345)
room_script room_345 {
    spawn_table { (1, 0) }

    actor_script actor_0 {
        SetHitCylinder(95, 115, 10);
        SceneCmd(2601, 128, 0, 0, 0, 0, 0, local[0]);
        Wait(1);
        ScaleShadowRadius(0xB333);
        SetEventHandler(EVENT_INTERACT, @label_00AA);
        SetEventHandler(EVENT_TOUCH, @label_00A6);
        if (global[ROOM] == 214 || global[ROOM] == 193) {
            SetEntityVec3(VEC3_POS, 1882.0fp, 0.0fp, -1065.5fp);
            SetEntityVec3(VEC3_ROT, 0, 1024, 0);
        } else {
            SetEntityVec3(VEC3_POS, 0.0fp, 0.0fp, 0.0fp);
            SetEntityVec3(VEC3_ROT, 0, 0, 0);
        }
        Wait(1);
        ExitThread();
    @label_00A6:
        ExitThread();
    @label_00AA:
        GetThreadTarget14(local[4]);
        if (local[4] == 254) {
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
        }
        if (local[4] == 255) {
            ResumeSceneEvents();
            SetAnim(21);
            UnlockPlayerInput();
        }
        ExitThread();
    }

    actor_script actor_1 {
        ClearScreenFadeFlag40();
        PauseSceneEvents();
        LockPlayerInput();
        AkaoCmd(0x193, 1002, 1002, 0, 0, room[19]);
        SetCameraBaseAngle(3072, 3408);
        SetMeshFadeLevel(112);
        SetGeomEntryPos(7, 0, 0, 32);
        SpawnActor(0, 0, 0.0fp, 0.0fp, 0.0fp);
        SpawnActor(2, 0, 0.0fp, 0.0fp, 0.0fp);
        Wait(1);
        SetEventHandler(EVENT_INTERACT, @label_007C);
        Wait(1);
        SetFadeColor(0x1E);
        WaitScreenFade();
        ResumeSceneEvents();
        UnlockPlayerInput();
        ExitThread();
    @label_007C:
        GetThreadTarget14(local[3]);
        ExitThread();
    }

    actor_script actor_2 {
        Wait(1);
        local[6] = 0;
        while (1) {
            GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
            TestPointInQuad(1982.0fp, -723.0fp, 1982.0fp, -1408.0fp, 2182.0fp, -1408.0fp, 2182.0fp, -723.0fp, local[0], local[2], local[4]);
            if (local[4] == 1 && local[6] == 0) {
                local[6] = 1;
                PauseSceneEvents();
                LockPlayerInput();
                StartScreenFade(10);
                WaitScreenFade();
                global[ROOM] = 346;
                ChangeRoom(0xA80291C8);
            }
            Wait(1);
        }
        ExitThread();
    }
}
