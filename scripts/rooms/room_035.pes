            SetAnimFrame(0);
            PlayAnimToFrame(50);
            WaitTextbox(13);
            SetAnim(4);
            SetAnimFrame(0);
            PlayAnimToFrame(26);
            WaitAnimEnd();
            SetAnim(0);
            SetAnim(14);
