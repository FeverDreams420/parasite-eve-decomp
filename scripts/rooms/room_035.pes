            SpawnActor(0, 0, 0.0fp, 0.0fp, 0.0fp);
            SpawnActor(2, 0, 0.0fp, 0.0fp, 0.0fp);
        }
        Wait(1);
        SetGeomEntryFlags(0, 0x10);
        SetGeomEntryFlags(1, 0x10);
        SetGeomEntryFlags(2, 0x10);
        SetGeomEntryField8(0, 65536);
        SetGeomEntryField8(1, 65536);
        SetGeomEntryField8(2, 65536);
        SetGeomFlagSlot(0, 1);
        SetGeomFlagSlot(1, 1);
        SetGeomFlagSlot(2, 1);
        SetFadeColor(0x1E);
