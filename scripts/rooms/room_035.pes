            WaitTextbox(5);
            PlayFieldSfx(0, 0, 4);
            OpenTextbox(6); // "Daniel. Yeah: but of all places,,, / the OPERA?! There's a story! Ha! | So why the oper..."
            SetAnim(1);
            SetAnimFrame(0);
            PlayAnimToFrame(42);
            WaitTextbox(6);
            SetAnim(0);
            PlayFieldSfx(0, 0, 1);
            OpenTextbox(7); // "{Aya}. Saw the ad in the paper, / I dunno,,, just caught my eye,,,"
            WaitTextbox(7);
            SetAnim(2);
            SetAnimFrame(0);
            PlayAnimToFrame(26);
            WaitAnimEnd();
            OpenTextbox(8); // "Daniel. Don't tell me you were on / to this case?! | Haha,,, so you finally got some co..."
            SetAnim(3);
            SetAnimFrame(0);
            PlayAnimToFrame(50);
            WaitTextbox(8);
            SetAnim(4);
            SetAnimFrame(0);
            PlayAnimToFrame(26);
            WaitAnimEnd();
            SetAnim(0);
            PlayFieldSfx(0, 0, 5);
            Wait(66);
            OpenTextbox(9); // "{Aya}. ,,,Instinct,,,?"
            WaitTextbox(9);
            PlayFieldSfx(0, 0, 6);
            OpenTextbox(10); // "{Aya}. Daniel,,, shouldn't you / be with your son? | It's Christmas Eve,,,"
            WaitTextbox(10);
            Wait(30);
            SetAnim(13);
            SetAnimFrame(0);
            PlayAnimToFrame(50);
            WaitAnimEnd();
            OpenTextbox(11); // "Daniel. He knows his dad's a cop,,, / My boy understands,,, | ANYWAY,,, to change the s..."
            SetAnim(1);
            SetAnimFrame(0);
            PlayAnimToFrame(42);
            WaitTextbox(11);
            SetAnim(0);
            Wait(60);
            PlayFieldSfx(0, 0, 24);
            Wait(60);
            OpenTextbox(12); // "{Aya}. ,,,Mitochondria,,, / mitochondria?,,, | Symbiosis,,,? | When was I in the hospit..."
            WaitTextbox(12);
            PlayFieldSfx(0, 0, 25);
            Wait(50);
            SetAnim(2);
            SetAnimFrame(0);
            PlayAnimToFrame(26);
            WaitAnimEnd();
            OpenTextbox(13); // "Daniel. ,,,Hey: {Aya},,, / You asleep? Oh well,,, | Don't blame ya,,, after what you've..."
