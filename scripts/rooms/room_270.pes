            WaitScreenFade();
            PlayFieldSfx(4, 0, 1);
            OpenTextbox(26); // "Lynch. Unfortunately the weapon / needs to be fired at close range / in order to work,"
            WaitTextbox(26);
            PlayFieldSfx(4, 0, 2);
            OpenTextbox(27); // ",,,And we cannot move in that / close since WE will be ignited,,,"
            WaitTextbox(27);
            StartScreenFade(15);
            WaitScreenFade();
            SetEntityVec3(VEC3_POS, 81.0fp, 0.0fp, 3904.0fp);
            SetEntityVec3(VEC3_ROT, 0, 3872, 0);
            PlayFieldSfx(2, 0, 251);
            PlayFieldSfx(4, 0, 251);
            Wait(5);
            SpawnActor(0, 0, 0.0fp, 0.0fp, 0.0fp);
            SpawnActor(5, 0, 0.0fp, 0.0fp, 0.0fp);
            LoadGeomState(1);
            SetFogNearFar(160, 121, 1);
            Wait(1);
            SetFadeColor(0xF);
            WaitScreenFade();
            PlayFieldSfx(0, 0, 10);
            OpenTextbox(28); // "{Aya}. Well,,,"
            WaitTextbox(28);
            Wait(75);
            PlayFieldSfx(0, 0, 11);
            OpenTextbox(29); // "{Aya}. ,,,I'll do it,,,!"
            WaitTextbox(29);
            SetAnim(1);
            CameraSnapToActor(0, 0, 45);
            SetAnim(0);
            PlayFieldSfx(5, 0, 49);
            OpenTextbox(30); // "Daniel. {Aya}! / NO WAY! You're not goin' UP THERE!!"
            SetAnim(3);
            SetAnimFrame(0);
            PlayAnimToFrame(60);
            WaitAnimEnd();
            WaitTextbox(30);
            PlayFieldSfx(2, 0, 48);
            Wait(30);
            OpenTextbox(31); // "Williams. Our fate lies in your / hands: {Aya},,,"
            WaitTextbox(31);
            PlayFieldSfx(0, 0, 21);
            Wait(60);
            PlayFieldSfx(0, 0, 14);
            OpenTextbox(32); // "{Aya}. OK? Daniel?,,,"
            WaitTextbox(32);
            SetAnim(7);
            SetAnimFrame(0);
            PlayAnimToFrame(40);
            WaitAnimEnd();
            OpenTextbox(33); // "Daniel. That,,, thing: that's not / Lorraine,"
            WaitTextbox(33);
            SetAnim(7);
            SetAnimFrame(40);
            PlayAnimToFrame(80);
            WaitAnimEnd();
            OpenTextbox(34); // ",,,Do it for Lorraine too: {Aya}!"
            SetAnim(3);
            SetAnimFrame(0);
            PlayAnimToFrame(60);
            WaitAnimEnd();
            WaitTextbox(34);
            PlayFieldSfx(5, 0, 8);
            OpenTextbox(35); // "Maeda. W: wait! / {Aya}: please take this,"
            WaitTextbox(35);
            PlayFieldSfx(0, 0, 22);
            Wait(60);
            OpenTextbox(36); // "Daniel. Come off it: man! We don't / have time for that right now!!"
            SetAnim(4);
            SetAnimFrame(0);
            PlayAnimToFrame(70);
            WaitAnimEnd();
            WaitTextbox(36);
            PlayFieldSfx(5, 0, 9);
            Wait(35);
            PlayFieldSfx(5, 0, 7);
            Wait(30);
            PlayFieldSfx(0, 0, 13);
            Wait(60);
            PlayFieldSfx(5, 0, 27);
            OpenTextbox(37); // "Maeda. Yes: of course,,, er,,, / {Aya}: please be careful up / there: OK?"
            WaitTextbox(37);
            PlayFieldSfx(0, 0, 14);
            OpenTextbox(38); // "{Aya}. Of course! I'll be fine,,,"
            WaitTextbox(38);
            AkaoCmd(0x198, 20, 1, 0, 0, room[17]);
            AkaoCmd(0x131, 30, 0, 0, 0, room[17]);
            StartScreenFade(60);
            WaitScreenFade();
            AkaoCmd(0x13A, 0, 0, 0, 0, room[17]);
            global[AREA] = 688;
            PlayFieldSfx(1, 0, 34);
            DestroySelf();
        }
        ExitThread();
