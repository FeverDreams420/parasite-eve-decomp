// Parasite Eve 1 Scene Script (room_229)
room_script room_229 {
    spawn_table { (1, 0) }

    actor_script actor_0 {
        SetHitCylinder(115, 135, 10);
        SceneCmd(2601, 128, 0, 0, 0, 0, 0, local[0]);
