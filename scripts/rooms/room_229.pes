    @label_009E:
        ExitThread();
    @label_00A2:
        GetThreadTarget14(local[4]);
        if (local[4] == 1) {
            OpenTextbox(53); // "Daniel. Hey: {Aya}!"
            PlayFieldSfx(1, 0, 1);
            WaitTextbox(53);
            SetAnim(32);
            SetAnimFrame(0);
            PlayAnimToFrame(59);
            Wait(30);
            PlayFieldSfx(0, 0, 1);
            OpenTextbox(54); // "Daniel. Over here!"
            WaitTextbox(54);
            WaitAnimEnd();
            PlayFieldSfx(1, 0, 2);
        }
        if (local[4] == 2) {
            SetAnim(1);
            CameraTrackActorAngle(0x08810000, 0x01C70000, 45);
            StopActorMotion();
            SetAnim(0);
            TurnToAngleStep(3040, 90);
            OpenTextbox(56); // "Daniel. Hey: it's open,,, Let's / check it out,"
            WaitTextbox(56);
            SetAnim(33);
            PlayFieldSfx(1, 0, 3);
            SetAnimFrame(0);
            PlayAnimToFrame(79);
            Wait(30);
            PlayFieldSfx(0, 0, 3);
            WaitAnimEnd();
        }
        if (local[4] == 3) {
