    }

    actor_script actor_3 {
        Wait(1);
        while (1) {
            GetActorPositionByType(0, 0, 0, local[0], local[1], local[2], local[3]);
            TestPointInQuad(1125.0fp, 1772.0fp, 1125.0fp, 1447.0fp, 1287.0fp, 1447.0fp, 1287.0fp, 1772.0fp, local[0], local[2], local[4]);
