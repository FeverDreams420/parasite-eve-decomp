        ScaleShadowRadius(0xB333);
        LockPlayerMoveMask(2);
        SetEventHandler(EVENT_INTERACT, @label_0098);
        SetEventHandler(EVENT_TOUCH, @label_0094);
        if (global[ROOM] == 195) {
            SetEntityVec3(VEC3_POS, 638.0fp, 0.0fp, 1399.0fp);
            SetEntityVec3(VEC3_ROT, 0, 512, 0);
        } else {
            SetEntityVec3(VEC3_POS, 2067.0fp, 0.0fp, 511.0fp);
            SetEntityVec3(VEC3_ROT, 0, 512, 0);
        }
        Wait(1);
        ExitThread();
    @label_0094:
        ExitThread();
    @label_0098:
        GetThreadTarget14(local[4]);
        GetEntityVec3(VEC3_POS, local[7], local[8], local[9]);
        if (local[4] == 254) {
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
        }
        if (local[4] == 255) {
            ResumeSceneEvents();
            SetAnim(21);
            UnlockPlayerInput();
        }
        if (local[4] == 1) {
            CameraSnapToActor(2, 0, 48);
        }
        if (local[4] == 2) {
            PauseSceneEvents();
            LockPlayerInput();
            StopActorMotion();
            SetAnim(21);
            CameraSnapToActor(2, 0, 48);
        }
        if (local[4] == 3) {
            StartScreenFade(30);
            WaitScreenFade();
            global[ROOM] = 230;
            ChangeRoom(0xA80434C8);
        }
        ExitThread();
    }

    actor_script actor_1 {
        ClearScreenFadeFlag40();
        PauseSceneEvents();
        LockPlayerInput();
        AkaoCmd(0x193, 1002, 1000, 0, 0, room[19]);
        SetCameraBaseAngle(0, 224);
        SetMeshFadeLevel(92);
        SetGeomEntryVisible(0, 0);
        global[34] = 16;
        SpawnActor(0, 0, 0.0fp, 0.0fp, 0.0fp);
        if (global[34] == 16 && global[AREA] < 208) {
            SpawnActor(2, 0, 0.0fp, 0.0fp, 0.0fp);
        } else if (global[34] == 17 && global[AREA] >= 208) {
            SpawnActor(2, 0, 1633.0fp, 0.0fp, 539.0fp);
        }
        SpawnActor(3, 0, 0.0fp, 0.0fp, 0.0fp);
        SpawnActor(4, 0, 0.0fp, 0.0fp, 0.0fp);
        SpawnActor(5, 0, 0.0fp, 0.0fp, 0.0fp);
        Wait(1);
        SetEventHandler(EVENT_INTERACT, @label_01C8);
        Wait(1);
        SetFadeColor(0x1E);
        WaitScreenFade();
        goto @label_0114;
        ExitThread();
    @label_0114:
        if (global[34] == 16 && global[AREA] < 208) {
            PlayFieldSfx(2, 0, 1);
        } else if (global[34] == 17 && global[AREA] >= 208) {
            PlayFieldSfx(2, 0, 3);
            StartScreenFade(30);
            OpenTextbox(107); // "Daniel. DAMN!"
            WaitTextbox(107);
            OpenTextbox(108); // "{Aya}. I could've sworn I've / seen this man,,, somewhere,,,"
            WaitTextbox(108);
            WaitScreenFade();
            global[ROOM] = 191;
            ChangeRoom(0xA8004048);
        } else {
            ResumeSceneEvents();
            UnlockPlayerInput();
        }
        ExitThread();
    @label_01C8:
        GetThreadTarget14(local[3]);
        if (local[3] == 1) {
            SetFogNearFar(352, 119, 30);
        }
        if (local[3] == 2) {
            ResetCameraToPlayer();
            WaitDiscIdle();
            PlayFieldSfx(0, 0, 255);
        }
        if (local[3] == 3) {
            AkaoCmd(0x12C, 2258, 0, 191, 127, room[19]);
            SetGeomEntryField8(0, 10485);
            SetGeomFlagSlot(0, 1);
        }
        ExitThread();
    }

    actor_script actor_2 {
        SetHitCylinder(130, 160, 10);
