                        AkaoCmd(0x190, 41, 0, 0, 0, room[20]);
                    } else {
                        AkaoCmd(0xC8, 15, 0, 0, 0, room[20]);
                        AkaoCmd(0x190, 15, 0, 0, 0, room[20]);
