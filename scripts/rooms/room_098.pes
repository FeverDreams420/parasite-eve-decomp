                        room[18] = room[18] - 1;
                        if (!(global[44] & 4096)) {
                            global[44] = global[44] | 4096;
                            if (global[AREA] == 400 && global[44] & 4096 && global[44] & 2048) {
                                global[44] = global[44] | 0x04000000;
                            }
                            PlayFieldSfx(0, 0, 9);
                            OpenTextbox(44); // "{Aya}. Warner!"
                            WaitTextbox(44);
                            while (room[18] == 0) {
                                Wait(1);
                            }
                            room[18] = room[18] - 1;
                            OpenTextbox(45); // "Warner. {Aya},,, Man: Eve / really caught us off guard,,, | Most of our men were out,,,"
                            SetAnim(11);
                            SetAnimFrame(0);
                            PlayAnimToFrame(70);
                            WaitAnimEnd();
                            WaitTextbox(45);
                            PlayFieldSfx(0, 0, 10);
                            OpenTextbox(46); // "{Aya}. I'm getting help! / Hang on!"
                            WaitTextbox(46);
                            while (room[18] == 0) {
                                Wait(1);
                            }
                            room[18] = room[18] - 1;
                            OpenTextbox(47); // "Warner. No worries,,, I'll be all / right, You go after Ben,,,!"
                            SetAnim(11);
                            SetAnimFrame(70);
                            PlayAnimToFrame(150);
                            WaitAnimEnd();
                            WaitTextbox(47);
                            SetAnim(11);
                            SetAnimFrame(150);
                            PlayAnimToFrame(169);
                            WaitAnimEnd();
                        } else if (!(global[46] & 8)) {
                            OpenTextbox(48); // "Warner. Here: take my clip,"
                            SetAnim(11);
                            SetAnimFrame(0);
                            PlayAnimToFrame(35);
                            WaitAnimEnd();
                            WaitTextbox(48);
                            GiveItem(2, local[6]);
                            ShowReceivedItemPopup(2);
                            Wait(1);
                            global[46] = global[46] | 8;
                            SetAnimStep(0xFFFF0000);
                            SetAnim(11);
                            SetAnimFrame(35);
                            PlayAnimToFrame(0);
                            WaitAnimEnd();
                            SetAnimStep(0x10000);
                        } else {
                            OpenTextbox(47); // "Warner. No worries,,, I'll be all / right, You go after Ben,,,!"
                            SetAnim(11);
                            SetAnimFrame(0);
                            PlayAnimToFrame(35);
                            WaitAnimEnd();
                            SetAnimStep(0xFFFF0000);
                            SetAnim(11);
                            SetAnimFrame(35);
                            PlayAnimToFrame(0);
                            SetAnimStep(0x10000);
