                } else {
                    AkaoCmd(0xC8, 10, 0, 0, 0, room[20]);
                    AkaoCmd(0x190, 39, 0, 0, 0, room[20]);
                }
            } else if (global[46] & 16384) {
                AkaoCmd(0xC8, 8, 0, 0, 0, room[20]);
            }
        }
        if (global[AREA] == 440) {
            if (!(global[46] & 0x00080000)) {
                AkaoCmd(0xCD, 8, 0, 0, 0, room[20]);
                AkaoCmd(0xCE, 8, 30, 127, 0, room[20]);
                global[46] = global[46] | 0x00080000;
